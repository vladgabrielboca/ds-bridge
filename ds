def service_auth():
    """Return (service base url, Authorization header) from service.json, or None."""
    try:
        with open(SERVICE_JSON) as f:
            svc = json.load(f)
        url = str(svc["url"]).rstrip("/")
        password = str(svc["password"])
        auth = base64.b64encode(f"opencode:{password}".encode()).decode()
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return url, "Basic " + auth


def interrupt_session(sid):
    """Ask the local OpenCode service to stop a session. True on success."""
    if not sid:
        return False
    got = service_auth()
    if not got:
        return False
    url, auth = got
    try:
        req = urllib.request.Request(
            f"{url}/api/session/{urllib.parse.quote(str(sid), safe='')}/interrupt",
            data=b"", method="POST",
            headers={"Authorization": auth, "Content-Type": "application/json"})
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(req, timeout=5) as resp:
            resp.read()
        return True
    except Exception:
        return False


def open_event_stream():
    """Open the local OpenCode SSE event stream, or return None if unavailable."""
    got = service_auth()
    if not got:
        return None
    url, auth = got
    req = urllib.request.Request(url + "/api/event", headers={
        "Accept": "text/event-stream",
        "Authorization": auth,
    })
    resp = None
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        resp = opener.open(req, timeout=3)
        # urllib's timeout also applies to reads; the connection is up now,
        # so clear it to make the consumer's readline() truly blocking.
        try:
            resp.fp.raw._sock.settimeout(None)
        except (AttributeError, OSError):
            pass
        return resp
    except Exception:
        if resp is not None:
            try:
                resp.close()
            except Exception:
                pass
        return None


def stderr_tail(path, limit=1000):
    """Read at most the last `limit` characters of a file, as one line."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - limit))
            data = f.read().decode("utf-8", "replace")
        return " ".join(data.split())
    except OSError:
        return ""


def _live_rate(segs, now_ms, cpt):
    """Live tok/s from active generation segments clipped to the last 5 s."""
    win_start = now_ms - 5000
    chars = dur_ms = 0.0
    keep = []
    for start, end, ch in segs:
        if end < win_start - 10000:
            continue
        keep.append((start, end, ch))
        if end <= win_start or start >= now_ms:
            continue
        span = end - start
        lo, hi = max(start, win_start), min(end, now_ms)
        if span <= 0 or hi <= lo:
            continue
        overlap = hi - lo
        chars += ch * overlap / span
        dur_ms += overlap
    if dur_ms >= 300 and chars:
        return int(round((chars / cpt) / (dur_ms / 1000))), keep
    return None, keep


def run_opencode(d, msg, model, agent, session=None, files=(), job=None,
                 limit_s=None, wrapup=False, deadline=None):
    c = cfg()
    limit_s = limit_s if limit_s is not None else c["timeout_s"]
    try:
        frac = float(c.get("soft_timeout_frac", 0.8))
    except (TypeError, ValueError):
        frac = 0.8
    soft_s = None if wrapup else limit_s * frac
    cmd = ["opencode", "run", "--format", "json", "--auto", "--agent", agent, "-m", model]
    if session:
        cmd += ["-s", session]
    for f in files:
        cmd += ["-f", f]
    cmd.append(msg)
    t0 = time.time()
    prev = (job or {}).get("_prog") or {}
    base_steps = int(prev.get("steps") or 0)
    base_tools = int(prev.get("tools") or 0)
    base_out = int(prev.get("out") or 0)
    inv_started = prev.get("started") or t0
    if job is not None:
        job["_prog"] = {"steps": base_steps, "tools": base_tools,
                        "out": base_out, "started": inv_started}
    sid, texts, errors = session, [], []
    tok = {"input": 0, "output": 0, "cache_read": 0}
    cost, tools, steps = 0.0, 0, 0
    step_open = False
    last = "thinking"
    cur_msg, cur_text = None, []
    live = {"available": False, "resp": None, "segs": [],
            "cpt": 3.5, "cal_chars": 0, "cal_tokens": 0, "step_chars": 0,
            "done_out": 0,
            "last_delta_ms": None, "last_gen_ms": None, "tools": {}, "args": {},
            "step_start_ms": None, "first_gen_ms": None, "last_step_gen_ms": None,
            "dec_tokens": 0, "dec_ms": 0, "ttft": []}
    progress_lock = threading.Lock()

    def current_out():
        if live["available"]:
            # SSE-side exact count for finished steps + current-step estimate;
            # stdout step_finish events lag behind and would make this jump.
            return live["done_out"] + int(round(live["step_chars"] / live["cpt"]))
        return tok["output"]

    def sync_prog(out=None):
        if job is None:
            return
        job["_prog"] = {"steps": base_steps + steps,
                        "tools": base_tools + tools,
                        "out": base_out + (current_out() if out is None else out),
                        "started": inv_started}

    def tok_s():
        return (round(live["dec_tokens"] / (live["dec_ms"] / 1000))
                if live["dec_ms"] else None)

    def ttft_s():
        med = _median(live["ttft"])
        return round(med / 1000, 1) if med is not None else None

    def live_view(now_ms):
        """Return live tok/s plus phase and its timing fields."""
        if not live["available"]:
            return None, None, None, None, None
        live_tok, live["segs"] = _live_rate(live["segs"], now_ms, live["cpt"])
        tool_since = args_since = args_tool = None
        if live["args"]:
            phase = "args"
            args_since = int(min(v[0] for v in live["args"].values()) // 1000)
            args_tool = max(live["args"].values(), key=lambda v: v[0])[1]
        elif live["tools"]:
            phase = "tool"
            tool_since = int(min(v[0] for v in live["tools"].values()) // 1000)
        elif (live["last_delta_ms"] is not None
              and now_ms - live["last_delta_ms"] <= 2000):
            phase = "writing"
        else:
            phase = "waiting"
        return live_tok, phase, tool_since, args_tool, args_since

    def write_progress(state, totals=None, **extra):
        with progress_lock:
            now_ms = int(time.time() * 1000)
            live_tok, phase, tool_since, args_tool, args_since = live_view(now_ms)
            last_shown = (max(live["tools"].values(), key=lambda v: v[0])[1]
                          if live["available"] and live["tools"] else last)
            if totals is None:
                totals = {"steps": base_steps + steps,
                          "tools": base_tools + tools,
                          "out": base_out + current_out(),
                          "started": inv_started}
            obj = {"state": state, "job": job["id"], "round": job["round"],
                   "model": model, "dir": os.path.basename(d),
                   "started": totals.get("started", inv_started),
                   "updated": time.time(), "steps": totals["steps"],
                   "tools": totals["tools"],
                   "last": last_shown, "pid": os.getpid(),
                   "out_tokens": totals["out"],
                   "tok_s": tok_s(), "ttft_s": ttft_s(), "live_tok_s": live_tok,
                   "phase": phase, "tool_since": tool_since, "args_tool": args_tool,
                   "args_since": args_since, "owner": job.get("owner") or ""}
            obj.update(extra)
            try:
                os.makedirs(PROGRESS, exist_ok=True)
                path = os.path.join(PROGRESS, job["id"] + ".json")
                tmp = path + f".tmp.{os.getpid()}"
                with open(tmp, "w") as f:
                    json.dump(obj, f)
                os.replace(tmp, path)
            except OSError:
                pass

    env = dict(os.environ, PWD=d)
    # opencode follows $PWD, not the process cwd
    stderr_file = tempfile.NamedTemporaryFile(prefix="ds-opencode-", suffix=".log",
                                              delete=False)
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=stderr_file,
                         stdin=subprocess.DEVNULL, text=True, cwd=d, env=env,
                         start_new_session=True)
    q = queue.Queue()

    def _reader():
        try:
            for line in p.stdout:
                q.put(line)
        finally:
            q.put(None)

    threading.Thread(target=_reader, daemon=True).start()

    stop_live = threading.Event()

    def _live_reader():
        nonlocal last
        resp = open_event_stream()
        if resp is None:
            return
        if stop_live.is_set():
            try:
                resp.close()
            except Exception:
                pass
            return
        with progress_lock:
            live["resp"] = resp
            live["available"] = True
        last_write = 0.0
        try:
            while not stop_live.is_set():
                try:
                    line = resp.readline()
                except Exception:
                    break
                if not line or stop_live.is_set():
                    break
                s = sid
                # Cheap pre-filter: most events belong to other sessions.
                if not s or s.encode() not in line:
                    continue
                try:
                    text = line.decode("utf-8", "replace")
                except Exception:
                    continue
                if not text.startswith("data:"):
                    continue
                try:
                    ev = json.loads(text[5:].strip())
                except ValueError:
                    continue
                data = ev.get("data") or {}
                if data.get("sessionID") != s:
                    continue
                now_ms = int(time.time() * 1000)
                created = ev.get("created")
                try:
                    created = int(created) if created is not None else now_ms
                except (TypeError, ValueError):
                    created = now_ms
                ty = ev.get("type")
                with progress_lock:
                    if ty in ("session.reasoning.delta", "session.text.delta"):
                        n = len(data.get("delta") or "")
                        if n:
                            prev = live["last_gen_ms"]
                            if prev is not None and created - prev <= 1000:
                                live["segs"].append((prev, created, n))
                            else:
                                # New burst: no active time for its first delta.
                                live["segs"].append((created, created, 0))
                            live["last_delta_ms"] = created
                            live["step_chars"] += n
                        live["last_gen_ms"] = created
                        if live["first_gen_ms"] is None:
                            live["first_gen_ms"] = created
                        live["last_step_gen_ms"] = created
                    elif ty == "session.step.started":
                        live["step_chars"] = 0
                        started = data.get("started")
                        try:
                            live["step_start_ms"] = (int(started)
                                                     if started is not None else created)
                        except (TypeError, ValueError):
                            live["step_start_ms"] = created
                        live["first_gen_ms"] = None
                        live["last_step_gen_ms"] = None
                    elif ty == "session.step.ended":
                        tk = data.get("tokens")
                        if not isinstance(tk, dict):
                            tk = {}
                        out_tok = int(tk.get("output") or 0) + int(tk.get("reasoning") or 0)
                        first_gen = live["first_gen_ms"]
                        last_gen = live["last_step_gen_ms"]
                        step_start = live["step_start_ms"]
                        if (out_tok > 0 and first_gen is not None
                                and last_gen is not None and step_start is not None):
                            span = last_gen - first_gen
                            if span >= 100:
                                live["dec_tokens"] += out_tok
                                live["dec_ms"] += span
                                live["ttft"].append(max(0, first_gen - step_start))
                        live["cal_chars"] += live["step_chars"]
                        live["cal_tokens"] += out_tok
                        live["done_out"] += out_tok
                        live["step_chars"] = 0
                        if live["cal_tokens"] > 0:
                            cpt = live["cal_chars"] / live["cal_tokens"]
                            live["cpt"] = min(8.0, max(1.5, cpt))
                        live["step_start_ms"] = None
                        live["first_gen_ms"] = None
                        live["last_step_gen_ms"] = None
                        live["tools"].clear()
                        live["args"].clear()
                    elif ty == "session.tool.input.started":
                        live["last_gen_ms"] = created
                        if live["first_gen_ms"] is None:
                            live["first_gen_ms"] = created
                        live["last_step_gen_ms"] = created
                        cid = data.get("id")
                        nm = data.get("name") or data.get("tool") or "tool"
                        if cid is not None:
                            live["args"][cid] = (created, nm)
                    elif ty == "session.tool.input.ended":
                        live["last_gen_ms"] = created
                        if live["first_gen_ms"] is None:
                            live["first_gen_ms"] = created
                        live["last_step_gen_ms"] = created
                        cid = data.get("id")
                        pending = live["args"].pop(cid, None) if cid is not None else None
                        if pending is not None:
                            start_ms = pending[0]
                            text = data.get("text")
                            if not isinstance(text, str):
                                text = "" if text is None else str(text)
                            n = len(text)
                            live["step_chars"] += n
                            if n:
                                live["segs"].append(
                                    (start_ms, max(start_ms, created), n))
                    elif ty == "session.tool.called":
                        inp = data.get("input")
                        if not isinstance(inp, dict):
                            inp = {}
                        nm = data.get("tool") or data.get("name") or "tool"
                        detail = (inp.get("command") or inp.get("path")
                                  or inp.get("filePath") or inp.get("pattern") or "")
                        if not isinstance(detail, str):
                            detail = str(detail)
                        label = " ".join(f"{nm} {detail}".split())[:60] or "tool"
                        cid = data.get("id") or f"call-{created}"
                        live["tools"][cid] = (created, label)
                        last = label
                    elif ty in ("session.tool.success", "session.tool.error",
                                "session.tool.failed"):
                        cid = data.get("id")
                        if cid is not None:
                            live["tools"].pop(cid, None)
                if stop_live.is_set():
                    break
                now = time.time()
                if now - last_write >= 1:
                    write_progress("running")
                    last_write = now
        finally:
            with progress_lock:
                live["available"] = False
                live["resp"] = None
            try:
                resp.close()
            except Exception:
                pass

    live_thread = threading.Thread(target=_live_reader, daemon=True)
    live_thread.start()
    timed_out, soft_hit = False, False
    stopped_by_ds = False
    stderr_text = ""
    n_events = 0
    last_tick = 0.0
    try:
        while True:
            elapsed = time.time() - t0
            if elapsed > limit_s:
                timed_out = True
                break
            if soft_s is not None and soft_s < limit_s and elapsed > soft_s:
                soft_hit = True
                break
            try:
                line = q.get(timeout=0.5)
            except queue.Empty:
                now = time.time()
                if now - last_tick >= 1:
                    write_progress("running")
                    last_tick = now
                continue
            if line is None:
                break
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            n_events += 1
            sid = ev.get("sessionID", sid)
            t, part = ev.get("type"), ev.get("part") or {}
            if t == "step_start":
                # A step_start with no step_finish since the last one is
                # OpenCode retrying the same step (e.g. provider overloaded).
                if not step_open:
                    steps += 1
                step_open = True
                if tools == 0:
                    last = "thinking"
            if t == "text":
                if part.get("messageID") != cur_msg:
                    cur_msg, cur_text = part.get("messageID"), []
                    texts.append(cur_text)
                cur_text.append(part.get("text", ""))
            elif t in ("tool_use", "tool"):
                tools += 1
                nm = part.get("tool") or "tool"
                inp = (part.get("state") or {}).get("input") or {}
                if nm == "shell":
                    detail = inp.get("command") or ""
                else:
                    detail = inp.get("path") or inp.get("filePath") or inp.get("pattern") or ""
                last = " ".join(f"{nm} {detail}".split())[:60]
            elif t == "step_finish":
                step_open = False
                tk = part.get("tokens") or {}
                tok["input"] += tk.get("input", 0)
                tok["output"] += tk.get("output", 0) + tk.get("reasoning", 0)
                tok["cache_read"] += (tk.get("cache") or {}).get("read", 0)
                cost += part.get("cost") or 0
            elif t == "error":
                errors.append((ev.get("error") or {}).get("message", "unknown error"))
            write_progress("running")
        if not timed_out and not soft_hit:
            p.wait()
    finally:
        if p.poll() is None:
            stopped_by_ds = True
            if sid:
                try:
                    interrupt_session(sid)
                except Exception:
                    pass
                try:
                    p.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    pass
            if p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except OSError:
                    pass
                try:
                    p.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(p.pid, signal.SIGKILL)
                    except OSError:
                        pass
                    try:
                        p.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        pass
        stop_live.set()
        with progress_lock:
            resp = live["resp"]
        if resp is not None:
            try:
                resp.close()
            except Exception:
                pass
        live_thread.join(timeout=2)
        with progress_lock:
            live["available"] = False
        try:
            stderr_file.close()
        except Exception:
            pass
        stderr_text = stderr_tail(stderr_file.name)
        try:
            os.remove(stderr_file.name)
        except OSError:
            pass
    if timed_out:
        errors.append(f"timeout after {int(limit_s)}s")
    if (not timed_out and not soft_hit and not stopped_by_ds
            and p.returncode not in (None, 0)):
        reason = stderr_text[:300] if stderr_text else "no stderr"
        errors.append(f"opencode exited {p.returncode}: {reason}")
    if n_events == 0 and not errors:
        errors.append("no output from opencode: " + (stderr_text[:300] or "empty stderr"))
    final = "".join(texts[-1]).strip() if texts else ""
    secs = round(time.time() - t0)
    write_progress("error" if errors else "done", updated=time.time(), secs=secs)
    sync_prog()
    res = {"session": sid, "report": final, "errors": errors, "tokens": tok,
           "cost": cost, "tools": tools, "secs": secs, "tok_s": tok_s(),
           "dec_tokens": live["dec_tokens"], "dec_ms": live["dec_ms"],
           "ttft": list(live["ttft"])}
    if soft_hit:
        if sid:
            wrap_limit = c["wrapup_s"]
            if deadline is not None:
                wrap_limit = min(wrap_limit, max(60, deadline - time.time()))
            w = run_opencode(d, WRAPUP_MSG, model, agent, session=sid, job=job,
                             limit_s=wrap_limit, wrapup=True, deadline=deadline)
            res["soft_deadline"] = {"at": secs, "limit_s": int(limit_s), "frac": frac}
            res["report"] = w["report"] or final
            for k in ("input", "output", "cache_read"):
                res["tokens"][k] += w["tokens"].get(k, 0)
            res["cost"] += w.get("cost", 0) or 0
            res["secs"] += w.get("secs", 0) or 0
            res["tools"] += w.get("tools", 0) or 0
            res["dec_tokens"] += w.get("dec_tokens") or 0
            res["dec_ms"] += w.get("dec_ms") or 0
            res["ttft"] += w.get("ttft") or []
            res["tok_s"] = (round(res["dec_tokens"] / (res["dec_ms"] / 1000))
                            if res["dec_ms"] else None)
            live["dec_tokens"] = res["dec_tokens"]
            live["dec_ms"] = res["dec_ms"]
            live["ttft"] = list(res["ttft"])
            res["errors"] += w["errors"]
            res["session"] = w.get("session") or sid
            write_progress("error" if res["errors"] else "done",
                           totals=job.get("_prog") if job is not None else None,
                           updated=time.time(), secs=res["secs"])
        else:
            res["errors"].append(f"soft deadline after {int(secs)}s (no session to wrap up)")
    return res


OVERLOAD_RE = re.compile(r"overloaded|rate.?limit|too many requests|retry shortly"
                         r"|\b(429|503|529)\b", re.I)


# Provider-side failures worth switching models for: overload/rate limits that survived
# the retries, plus quota, billing, auth-on-model and 5xx errors (waiting won't fix those).
PROVIDER_FAIL_RE = re.compile(r"overloaded|rate.?limit|too many requests|retry shortly|quota"
                              r"|insufficient|exceeded|billing|credit|unavailable|bad gateway"
                              r"|\b(402|429|500|502|503|504|529)\b", re.I)


def is_provider_failure(errors):
    return (any(PROVIDER_FAIL_RE.search(str(e)) for e in errors)
            and not any(str(e).startswith("timeout after") for e in errors))


FAILOVER_MSG = (
    "Your previous request failed on the model provider's side (not your fault); you are "
    "now running on a different model in the same session. Continue the task where it "
    "left off: check what is already done before redoing anything, then reply with the "
    "usual final report block.")


def is_overload(errors):
    # OpenCode also exits non-zero after giving up, which adds an "opencode
    # exited" error next to the provider's; timeouts never match.
    return (any(OVERLOAD_RE.search(str(e)) for e in errors)
            and not any(str(e).startswith("timeout after") for e in errors))


def merge_results(first, later):
    """Combine two run_opencode results of the same session; later wins for text."""
    out = dict(later)
    out["tokens"] = {k: first["tokens"].get(k, 0) + later["tokens"].get(k, 0)
                     for k in ("input", "output", "cache_read")}
    for k in ("cost", "secs", "tools", "dec_tokens", "dec_ms"):
        out[k] = (first.get(k) or 0) + (later.get(k) or 0)
    out["ttft"] = (first.get("ttft") or []) + (later.get("ttft") or [])
    out["tok_s"] = (round(out["dec_tokens"] / (out["dec_ms"] / 1000))
                    if out["dec_ms"] else None)
    out["report"] = later.get("report") or first.get("report")
    out["session"] = later.get("session") or first.get("session")
    if first.get("soft_deadline") and not later.get("soft_deadline"):
        out["soft_deadline"] = first["soft_deadline"]
    return out


def run_retrying(d, msg, model, agent, session=None, files=(), job=None,
                 limit_s=None, deadline=None):
    """run_opencode, continuing the same session when the provider is overloaded.

    OpenCode already retries a step for about two minutes before giving up; this
    waits longer between whole attempts (config overload_wait_s) so a busy
    provider has time to recover instead of failing the job.
    """
    c = cfg()
    waits = list(c.get("overload_wait_s") or [])[:max(0, int(c.get("overload_retries") or 0))]
    t0 = time.time()
    res = run_opencode(d, msg, model, agent, session=session, files=files, job=job,
                       limit_s=limit_s, deadline=deadline)
    tries = 0
    while is_overload(res["errors"]) and tries < len(waits) and job is not None:
        sid = res.get("session") or session
        if not sid:
            break
        wait = float(waits[tries])
        left = [x for x in (
            (limit_s - (time.time() - t0)) if limit_s is not None else None,
            (deadline - time.time()) if deadline is not None else None) if x is not None]
        if left and min(left) < wait + FIX_MIN_S:
            break
        tries += 1
        write_progress_file(job, model, state="running",
                            last=f"provider overloaded · retry {tries}/{len(waits)}",
                            phase="tool", tool_since=int(time.time()), live_tok_s=None,
                            args_tool=None, args_since=None)
        time.sleep(wait)
        lim = None if limit_s is None else max(1.0, limit_s - (time.time() - t0))
        nxt = run_opencode(d, OVERLOAD_MSG, model, agent, session=sid, job=job,
                           limit_s=lim, deadline=deadline)
        res = merge_results(res, nxt)
    if tries:
        res["overload_retries"] = tries
        if res["errors"]:
            res["errors"] = res["errors"] + [f"still failing after {tries} overload "
                                             "retr" + ("y" if tries == 1 else "ies")]
    fb = (c.get("fallback_model") or "").strip()
    sid = res.get("session") or session
    if (fb and fb != model and job is not None and sid and res["errors"]
            and is_provider_failure(res["errors"])):
        left = [x for x in (
            (limit_s - (time.time() - t0)) if limit_s is not None else None,
            (deadline - time.time()) if deadline is not None else None) if x is not None]
        if not left or min(left) > FIX_MIN_S:
            first_err = str(res["errors"][0])[:160]
            write_progress_file(job, fb, state="running", last=f"failover to {fb}",
                                phase="tool", tool_since=int(time.time()), live_tok_s=None,
                                args_tool=None, args_since=None)
            lim = None if limit_s is None else max(1.0, limit_s - (time.time() - t0))
            nxt = run_opencode(d, FAILOVER_MSG, fb, agent, session=sid, job=job,
                               limit_s=lim, deadline=deadline)
            prev_errors = res["errors"]
            res = merge_results(res, nxt)
            res["errors"] = nxt["errors"]   # the fallback's outcome decides the job
            res["failover"] = {"from": model, "to": fb, "reason": first_err,
                               "ok": not nxt["errors"], "first_errors": prev_errors[:2]}
            # later calls of this invocation (fix rounds, found note) stay on the fallback
            job.setdefault("model_primary", model)
            job["model"] = fb
    return res


def write_progress_file(job, model, **fields):
    path = os.path.join(PROGRESS, job["id"] + ".json")
    try:
        obj = json.load(open(path))
    except (OSError, ValueError):
        obj = {"state": "running", "started": time.time(), "steps": 0, "tools": 0,
               "out_tokens": 0, "tok_s": None, "ttft_s": None,
               "job": job["id"], "round": job["round"],
               "model": model, "dir": os.path.basename(proj(job))}
    obj["owner"] = job.get("owner") or ""
    obj.update(fields)
    obj["pid"] = os.getpid()
    obj["updated"] = time.time()
    try:
        os.makedirs(PROGRESS, exist_ok=True)
        tmp = path + f".tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(obj, f)
        os.replace(tmp, path)
    except OSError:
        pass


def write_check_progress(job, model, cmd):
    write_progress_file(job, model, state="running", last="check: " + cmd[:40],
                        phase="tool", tool_since=int(time.time()), live_tok_s=None,
                        args_tool=None, args_since=None)


def run_check(d, cmd, timeout_s):
    """Run cmd with bash -c in d; return pass flag, exit code and last 60 lines."""
    env = dict(os.environ, PWD=d)
    try:
        r = subprocess.run(["bash", "-c", cmd], cwd=d, env=env, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True, timeout=timeout_s)
        out, code = r.stdout or "", r.returncode
    except subprocess.TimeoutExpired as e:
        out = e.stdout or ""
        if isinstance(out, bytes):
            out = out.decode(errors="replace")
        out += f"\n[check timed out after {timeout_s}s]"
        code = 124
    lines = out.splitlines()
    res = {"pass": code == 0, "code": code, "output": "\n".join(lines[-60:])}
    if code != 0:
        m = ENV_OUTPUT.search(out)
        if code in (126, 127) or m:
            res["env"] = f"exit {code}" + (f": {m.group(0).strip()[:120]}" if m else "")
    return res


# Output only a shell or loader prints when it cannot run the command at all (after cheap-agent's
# envFailure): no code edit fixes these, so fix rounds would only burn time.
ENV_OUTPUT = re.compile(r"command not found|No module named (?:pytest|pip)\b|is not recognized as an internal"
                        r"|cannot execute binary|No such file or directory: .*\b(node|npx|python3?|pytest|go|cargo)\b"
                        r"|ModuleNotFoundError: No module named '(?:pytest|_pytest)'", re.I)


# Failure condensing, ported from cheap-ag's errorTail (src/verify.ts, MIT).
_ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
_MARKER = re.compile(r"✗|✘|×|\bFAIL\b|Error:|error TS\d+|AssertionError|Traceback|panicked|^E\s{2,}")
_DETAIL = re.compile(r"expected|received|\bgot\b|\bwant\b|^\s*[-+] ", re.I)
_FRAME = re.compile(r'^\s*(at |File ")|\.(ts|tsx|js|mjs|cjs|py|go|rs):\d+')
_NOISE = re.compile(r"^\s*(✓|√|PASS\b|ok\b)|^\s*(Tests?|Test Files|Suites?)\b.*\bpassed\b"
                    r"|^\s*[.·•⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]+$")


def error_tail(output, root=None, max_failures=3, max_lines=25):
    """Up to 3 distinct failures (repeats counted ×N), each with its message, expected/got
    lines and first in-repo frame; at most 25 lines of 200 chars. Falls back to the last
    lines when no failure marker is found."""
    text = _ANSI.sub("", output or "")
    if root:
        text = text.replace(root.rstrip("/") + "/", "")
    lines = [l.replace("\t", "  ").rstrip() for l in text.splitlines()]
    lines = [l for l in lines if l.strip() and (_MARKER.search(l) or not _NOISE.search(l))]
    fails = []
    i = 0
    while i < len(lines):
        if not _MARKER.search(lines[i]):
            i += 1
            continue
        block, frame, j = [lines[i].strip()], False, i + 1
        while j < len(lines) and j <= i + 12 and not _MARKER.search(lines[j]):
            if _DETAIL.search(lines[j]) and len(block) < 5:
                block.append("  " + lines[j].strip())
            elif (not frame and _FRAME.search(lines[j])
                  and not re.search(r"node_modules|node:internal|site-packages", lines[j])):
                block.append("  " + lines[j].strip())
                frame = True
            j += 1
        key = re.sub(r"\d+", "#", block[0])
        same = next((f for f in fails if f["key"] == key), None)
        if same:
            same["n"] += 1
        else:
            fails.append({"key": key, "lines": block, "n": 1})
        i = max(i + 1, j)
    if fails:
        body = []
        for f in fails[:max_failures]:
            head = f["lines"][0] + (f" (×{f['n']})" if f["n"] > 1 else "")
            body += [head] + f["lines"][1:]
    else:
        body = lines[-(max_lines - 1):]
    clip = lambda l: l if len(l) <= 200 else l[:120] + " … " + l[-77:]
    return [clip(l) for l in body[:max_lines]]


def same_failure(a, b):
    norm = lambda t: re.sub(r"\d+", "#", "\n".join(t))
    return norm(a) == norm(b)


FOUND_MSG = ("STOP. The check still fails and there will be no more fix rounds. Do not edit "
             "anything. Reply with ONLY one line starting `FOUND:` (at most 600 characters): "
             "where the problem is (file, function, line), your best hypothesis for the cause, "
             "and what you ruled out.")


def run_with_check(job, msg, session=None, files=(), budget_s=None):
    """Run the worker, then keep auto-fixing until the job's check passes."""
    d = job["dir"]
    c = cfg()
    try:
        budget_s = float(budget_s if budget_s is not None else c["job_budget_s"])
    except (TypeError, ValueError):
        budget_s = 1800.0
    deadline = time.time() + max(0.0, budget_s)

    def remaining():
        return deadline - time.time()

    def limit(cap):
        return min(cap, max(1.0, remaining()))

    res = run_retrying(d, msg, job["model"], job["agent"], session=session, files=files,
                       job=job, limit_s=limit(c["timeout_s"]), deadline=deadline)
    if res["errors"]:
        return res
    check = job.get("check")
    if not check:
        return res
    tries = max(0, int(job.get("fix_tries") or 0))
    timeout_s = c["check_timeout_s"]
    results, rounds, skipped, stuck, prev = [res], 0, 0, False, None
    while True:
        write_check_progress(job, job["model"], check)
        chk = run_check(d, check, limit(timeout_s))
        tail = error_tail(chk["output"], d)
        if chk["pass"] or rounds >= tries or chk.get("env"):
            break
        if prev is not None and same_failure(prev, tail):
            stuck = True   # the last fix round changed nothing about the failure
            break
        prev = tail
        if remaining() < FIX_MIN_S:
            skipped = tries - rounds
            break
        rounds += 1
        fmsg = (f"AUTOMATED CHECK FAILED (not the reviewer). Command: {check}\n"
                f"Exit: {chk['code']}\nLast output lines:\n{chk['output']}\n"
                "Fix the cause within the original task scope, then reply with the "
                "final report block.")
        res = run_retrying(d, fmsg, job["model"], job["agent"],
                           session=res.get("session") or job.get("session"), job=job,
                           limit_s=limit(c["timeout_s"]), deadline=deadline)
        results.append(res)
        if res["errors"]:
            return res
    last = results[-1]
    tok = {k: sum(r["tokens"].get(k, 0) for r in results)
           for k in ("input", "output", "cache_read")}
    out = dict(last)
    out["tokens"] = tok
    out["cost"] = sum(r.get("cost", 0) or 0 for r in results)
    out["secs"] = sum(r.get("secs", 0) or 0 for r in results)
    out["dec_tokens"] = sum(r.get("dec_tokens") or 0 for r in results)
    out["dec_ms"] = sum(r.get("dec_ms") or 0 for r in results)
    out["ttft"] = [x for r in results for x in (r.get("ttft") or [])]
    out["tok_s"] = (round(out["dec_tokens"] / (out["dec_ms"] / 1000))
                    if out["dec_ms"] else None)
    soft = [r["soft_deadline"] for r in results if r.get("soft_deadline")]
    if soft:
        out["soft_deadline"] = soft[0]
    retried = sum(r.get("overload_retries") or 0 for r in results)
    if retried:
        out["overload_retries"] = retried
    out["check"] = {"cmd": check, "pass": chk["pass"], "code": chk["code"],
                    "output": chk["output"], "tail": tail, "rounds": rounds, "stuck": stuck,
                    **({"env": chk["env"]} if chk.get("env") else {})}
    if not chk["pass"] and not chk.get("env") and not last["errors"] and remaining() > 60:
        fr = run_retrying(d, FOUND_MSG, job["model"], job["agent"],
                          session=last.get("session") or job.get("session"), job=job,
                          limit_s=limit(180), deadline=deadline)
        m = re.search(r"FOUND:\s*(.+)", fr.get("report") or "", re.S)
        if m:
            out["found"] = " ".join(m.group(1).split())[:600]
    if skipped:
        out["check"]["budget_skipped"] = skipped
    ttft_med = _median(out["ttft"])
    write_progress_file(job, job["model"], state="error" if last["errors"] else "done",
                        last="check: " + ("pass" if chk["pass"] else "fail"),
                        secs=out["secs"], out_tokens=tok["output"], tok_s=out["tok_s"],
                        ttft_s=(round(ttft_med / 1000, 1) if ttft_med is not None else None))
    return out


def diff_text(job, full=False, paths=(), since=None):
    d, gd = job["dir"], job["shadow"]
    idx = job_index(job["id"])
    job_paths = job.get("paths")
    stage_paths(gd, d, job_paths, idx)
    scope = list(paths) if paths else (job_paths or [])
    since = since or job["base"]
    stat = git(gd, d, "diff", "--cached", "--stat=100", since, "--", *scope, index=idx)
    body = git(gd, d, "diff", "--cached", "-U2", "--no-color", since, "--", *scope, index=idx)
    lines = body.splitlines()
    jdir = os.path.join(JOBS, job["id"])
    open(os.path.join(jdir, "full.diff"), "w").write(body)
    cap = cfg()["max_diff_lines"]
    if not full and len(lines) > cap:
        body = "\n".join(lines[:cap]) + (
            f"\n... [diff truncated: {len(lines) - cap} more lines. "
            f"`ds diff {job['id']} --full` or `ds diff {job['id']} <path>`; "
            f"file: {jdir}/full.diff]")
    return stat.strip(), body


def save(job):
    p = os.path.join(JOBS, job["id"], "job.json")
    tmp = p + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({k: v for k, v in job.items() if not k.startswith("_")},
                  f, indent=1)
    os.replace(tmp, p)


def load(jid):
    p = os.path.join(JOBS, jid, "job.json")
    if not os.path.exists(p):
        die(f"no job {jid}")
    return json.load(open(p))


def _median(vals):
    vals = sorted(vals)
    if not vals:
        return None
    n = len(vals)
    return vals[n // 2] if n % 2 else (vals[n // 2 - 1] + vals[n // 2]) / 2


def fmt_num(n):
    """Format a token count as 1.2M / 340k / 912."""
    n = int(round(n))
    sign = "-" if n < 0 else ""
    a = abs(n)
    if a >= 1_000_000:
        return f"{sign}{a / 1_000_000:.1f}M" if a < 10_000_000 else f"{sign}{a / 1_000_000:.0f}M"
    if a >= 1_000:
        return f"{sign}{a / 1_000:.1f}k" if a < 10_000 else f"{sign}{a / 1_000:.0f}k"
    return f"{sign}{a}"


def saved_tokens(worker_in, worker_cache, worker_out, claude_chars):
    return worker_in + 0.1 * worker_cache + worker_out - claude_chars / 4


def _entry_saved(e):
    return saved_tokens(int(e.get("worker_in") or 0),
                        int(e.get("worker_cache") or 0),
                        int(e.get("worker_out") or 0),
                        int(e.get("claude_chars") or 0))


def refresh_today():
    """Recompute today.json from the ledger (old formula values get corrected)."""
    today = time.strftime("%Y-%m-%d")
    saved = 0
    job_ids = set()
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                ts = e.get("ts") or 0
                try:
                    day = time.strftime("%Y-%m-%d", time.localtime(ts))
                except (OSError, ValueError, OverflowError):
                    continue
                if day != today:
                    continue
                saved += int(round(_entry_saved(e)))
                if e.get("job"):
                    job_ids.add(e["job"])
    except OSError:
        pass
    try:
        tmp = TODAY + f".tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump({"date": today, "saved_tokens": saved,
                       "jobs": len(job_ids)}, f)
        os.replace(tmp, TODAY)
    except OSError:
        pass


def record_ledger(job, res, claude_chars):
    tk = res["tokens"]
    ttft_med = _median(res.get("ttft") or [])
    entry = {"ts": int(time.time()), "job": job["id"], "round": job["round"],
             "dir": proj(job), "worker_in": tk["input"],
             "worker_cache": tk["cache_read"], "worker_out": tk["output"],
             "claude_chars": claude_chars, "secs": res.get("secs"),
             "tok_s": res.get("tok_s"),
             "ttft_ms": (int(round(ttft_med)) if ttft_med is not None else None),
             "check": (None if not res.get("check")
                       else "pass" if res["check"]["pass"] else "fail")}
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, ".ledger.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with open(LEDGER, "a") as f:
                f.write(json.dumps(entry, separators=(",", ":")) + "\n")
            refresh_today()
    except Exception:
        pass


REPORT_KEYS = ("STATUS", "SUMMARY", "RISKS", "REVIEW", "MISSING", "DISAGREE", "VISUAL",
               "QUESTION", "FOUND", "REPRO", "CHECKS", "NOTES")
NONE_RE = re.compile(r"^\s*(none|n/?a|-)?\s*\.?\s*$", re.I)


def parse_report(rep):
    """The worker's final block as {KEY: text}; continuation lines join their key."""
    out, cur = {}, None
    for line in (rep or "").splitlines():
        m = re.match(r"^\s*([A-Z]+):\s*(.*)$", line)
        if m and m.group(1) in REPORT_KEYS:
            cur = m.group(1)
            out[cur] = m.group(2).strip()
        elif cur and line.strip():
            out[cur] = (out[cur] + " " + line.strip().lstrip("- ")).strip()
    return {k: v for k, v in out.items() if not NONE_RE.match(v)}


def _clip(text, n):
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:n - 1] + "…"


def numstat(job, since=None):
    gd, w = job["shadow"], job["dir"]
    base = since or job["base"]
    post = job.get("post") or base
    out = git(gd, w, "diff", "--numstat", "--no-renames", base, post, check=False)
    files = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            a, d_, p = parts
            files.append((p, int(a) if a.isdigit() else 0, int(d_) if d_.isdigit() else 0))
    return files


def job_status(res, rep):
    chk = res.get("check")
    if res["errors"]:
        return "PROVIDER" if is_provider_failure(res["errors"]) else "ERROR"
    if rep.get("STATUS", "").upper().startswith("BLOCKED"):
        return "BLOCKED"
    if chk and not chk.get("pass"):
        return "FAIL"
    if (res.get("repro") or "").startswith(("FAILED", "WEAK")):
        return "FAIL"
    if res.get("soft_deadline"):
        return "PARTIAL"
    return "OK"


REDO_MSG = ("Your change could not land: the project changed meanwhile in {files}. Your copy was rebuilt "
            "from the current project with your change applied again where it could be; files where both "
            "changed the same lines hold <<<<<<< ======= >>>>>>> conflict markers: {marked}. Keep the "
            "project's current changes, redo your task's intent on top of them, leave no conflict markers, "
            "run the check, then reply with the final report block.")


def auto_land(job, res):
    """Land a passed job. Copy jobs: 3-way apply, one automatic redo on conflict. Returns None or the
    conflict text; on success the job is "landed" (undo with ds reject until it is cleaned up)."""
    if job.get("project"):
        conflict = land(job)
        if conflict:
            names = conflict_paths(conflict) or ["(see ds diff)"]
            marked = rebase_job(job)
            rr = run_with_check(job, REDO_MSG.format(files=", ".join(names), marked=", ".join(marked) or "none"),
                                session=job.get("session"))
            job["post"] = snapshot(job["dir"], job["shadow"], f"post redo {job['id']}",
                                   job_index(job["id"]), job["id"], job.get("paths"))
            res["redo"] = True
            if rr.get("report"):
                res["report"] = rr["report"]
            ok = (not rr["errors"] and (not rr.get("check") or rr["check"].get("pass"))
                  and not leftover_markers(job))
            if not ok:
                save(job)
                return conflict
            conflict = land(job)
            if conflict:
                save(job)
                return conflict
        drop_copy(job)
    job["status"] = "landed"
    job["landed_at"] = time.time()
    save(job)
    return None


def conflict_paths(text):
    named = re.findall(r"^Applied patch to '(.+)' with conflicts\.$|^error: (.+?): (?:does not exist in index"
                       r"|does not match index|already exists in (?:index|working directory)|patch does not apply)$",
                       text or "", re.M)
    return sorted(set(a or b for a, b in named))


def finish_job(job, res):
    """Decide the status, auto-land a passed job, print the compact result block."""
    c = cfg()
    raw = res["report"] or ""
    rep = parse_report(raw)
    status = job_status(res, rep)
    chk = res.get("check")
    landed, conflict = False, None
    if (status == "OK" and chk and chk.get("pass") and c.get("auto_land", True)
            and not res.get("outside")):
        conflict = auto_land(job, res)
        landed = conflict is None
        if conflict:
            status = "CONFLICT"
    text = render_block(job, res, rep, raw, status, landed, conflict)
    sys.stdout.write(text)
    record_ledger(job, res, len(text))
    return status


def render_block(job, res, rep, raw, status, landed, conflict):
    c = cfg()
    jid = job["id"]
    chk = res.get("check")
    rb = job.get("round_base")
    files = numstat(job, since=rb)
    add, dele = sum(f[1] for f in files), sum(f[2] for f in files)
    head = [status, jid, f"files={len(files)}", f"+{add}/-{dele}"]
    if chk:
        head.append("check=" + ("pass" if chk.get("pass") else "env" if chk.get("env") else "fail"))
    repro = res.get("repro") or ""
    if repro:
        head.append("repro=" + ("fail→pass" if repro.startswith("fail→pass") else repro.split(":")[0].split()[0].lower()))
    head.append(f"{res.get('secs', 0)}s")
    if job["round"] > 1:
        head.append(f"round={job['round']}")
    if res.get("redo"):
        head.append("redo=1")
    if landed:
        head.append("landed")
    elif job.get("project"):
        head.append("in-copy")
    out = [" ".join(head)]
    summary = rep.get("SUMMARY") or (raw.strip().splitlines()[0] if raw.strip() else "(worker gave no report)")
    out.append("summary: " + _clip(summary, 200))
    if files and status != "BLOCKED":
        out.append("changed: " + ", ".join(f"{p} +{a}/-{d}" for p, a, d in files[:15])
                   + (f", … +{len(files) - 15} more" if len(files) > 15 else ""))
    for key in ("RISKS", "REVIEW", "MISSING", "DISAGREE", "VISUAL"):
        if rep.get(key):
            out.append(f"{key.lower()}: {_clip(rep[key], 400)}")
    if status == "BLOCKED" and rep.get("QUESTION"):
        out.append("question: " + _clip(rep["QUESTION"], 600))
    if repro and not repro.startswith("fail→pass"):
        out.append("repro: " + _clip(repro, 300))
    if status not in ("OK",):
        found = res.get("found") or rep.get("FOUND")
        if found:
            out.append("found: " + _clip(found, 600))
    if chk and not chk.get("pass"):
        if chk.get("env"):
            out.append(f"error: environment: `{_clip(chk['cmd'], 120)}` could not run ({chk['env']}); "
                       "no code fix was attempted")
        else:
            out.append(f"error: `{_clip(chk['cmd'], 160)}` exit {chk['code']} after {chk['rounds']} fix rounds"
                       + ("; the same failure repeated" if chk.get("stuck") else ""))
            for line in (chk.get("tail") or chk["output"].splitlines()[-15:])[:15]:
                out.append("  " + line)
    if res["errors"]:
        out.append("error: " + _clip(" | ".join(e[:300] for e in res["errors"]), 500))
    fo = res.get("failover")
    if fo:
        out.append(f"note: {fo['from']} failed on the provider side; continued on {fo['to']}"
                   + ("" if fo["ok"] else " (it failed too)"))
    if res.get("soft_deadline"):
        out.append(f"note: soft deadline hit at {res['soft_deadline']['at']}s; the worker wrapped up early")
    if job.get("copy_error"):
        out.append(f"note: no private copy ({job['copy_error']}); ran in place")
    if conflict:
        out.append("conflict: " + ", ".join(conflict_paths(conflict) or ["see ds diff"])
                   + " (the automatic redo could not reconcile it; the project is unchanged)")
    if res.get("outside"):
        out.append("warning: changes outside --paths: " + "; ".join(res["outside"][:10]))
    if res.get("excluded_note"):
        out.append(res["excluded_note"].replace("--- NOTE ", "note: "))
    block = "\n".join(out)
    if len(block) > c.get("max_block_chars", 1600):
        block = block[:c.get("max_block_chars", 1600)] + " …"
    trusted = (chk and chk.get("pass") and c.get("diff_on_pass", "stat") == "stat"
               and status in ("OK", "CONFLICT") and not res.get("outside"))
    tail = []
    if status not in ("BLOCKED", "PROVIDER", "ERROR") and not trusted:
        stat, body = diff_text(job, since=rb)
        if body:
            tail += ["--- diff" + (f" (this round; cumulative: ds diff {jid})" if rb else ""), body]
    if status == "OK" and landed:
        tail.append(f"next: nothing to do (undo: ds reject {jid})")
    elif status == "OK":
        tail.append(f"next: ds approve {jid} | ds revise {jid} \"1. ...\" | ds reject {jid}")
    elif status == "BLOCKED":
        tail.append(f"next: ds reply {jid} <option letter or short answer>")
    elif status == "CONFLICT":
        tail.append(f"next: ds revise {jid} \"1. In <file>, resolve ...\" | ds reject {jid}")
    elif status in ("PROVIDER", "ERROR"):
        tail.append("next: ds/provider error: tell the user and stop; don't do the work yourself.")
    else:
        tail.append("next: not finished: ask the user one question: a Sonnet subagent finishes it (from found: "
                    f"and the job's files; costs Claude usage), ds revise {jid} with the findings, or stop. "
                    "Don't pick for them; don't take it over yourself.")
    return block + "\n" + "\n".join(tail) + "\n"


def gc_landed(max_age_s=86400):
    """Landed jobs older than a day become approved and drop their snapshots (no more undo)."""
    try:
        names = os.listdir(JOBS)
    except OSError:
        return
    now = time.time()
    for n in names:
        p = os.path.join(JOBS, n, "job.json")
        try:
            job = json.load(open(p))
        except (OSError, ValueError):
            continue
        if job.get("status") == "landed" and now - float(job.get("landed_at") or 0) > max_age_s:
            job["status"] = "approved"
            save(job)
            cleanup_shadow(job)


def notify_cmd(job, res):
    """Return the notify-send argv for a finished job, or None to stay quiet."""
    c = cfg()
    if not c.get("notify", True):
        return None
    try:
        min_s = int(c.get("notify_min_s", 15))
    except (TypeError, ValueError):
        min_s = 15
    secs = int(res.get("secs") or 0)
    if secs < min_s or not shutil.which("notify-send"):
        return None
    base = os.path.basename(proj(job).rstrip("/")) or proj(job)
    when = f"{secs // 60}:{secs % 60:02d}"
    errs = res.get("errors") or []
    if errs:
        title = f"DeepSeek {job['id']} failed"
        body = f"{base} · {when} · {str(errs[0])[:100]}"
    else:
        title = f"DeepSeek {job['id']} done"
        body = f"{base} · {when}"
        chk = res.get("check")
        if chk:
            body += " · check " + ("PASS" if chk["pass"] else "FAIL")
    return ["notify-send", "-a", "ds-bridge", title, body]


def notify_done(job, res):
    try:
        cmd = notify_cmd(job, res)
        if cmd:
            subprocess.run(cmd, timeout=5, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    except Exception:
        pass


def cmd_stats(a):
    now = time.time()
    if a.all:
        cutoff = None
    elif a.days is not None:
        cutoff = now - int(a.days) * 86400
    else:
        lt = time.localtime()
        cutoff = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1))
    rows = []
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if cutoff is None or e.get("ts", 0) >= cutoff:
                    rows.append(e)
    except OSError:
        pass
    win = sum(int(e.get("worker_in") or 0) for e in rows)
    wca = sum(int(e.get("worker_cache") or 0) for e in rows)
    wout = sum(int(e.get("worker_out") or 0) for e in rows)
    chars = sum(int(e.get("claude_chars") or 0) for e in rows)
    claude_tok = chars / 4
    saved = saved_tokens(win, wca, wout, chars)
    jobs = len({e.get("job") for e in rows if e.get("job")})
    print(f"jobs {jobs} · rounds {len(rows)}")
    print(f"worker tokens: in {fmt_num(win)} / cache {fmt_num(wca)} / out {fmt_num(wout)}")
    print(f"Claude read: {fmt_num(chars)} chars ≈ {fmt_num(claude_tok)} tokens")
    print(f"est. saved: ≈ {fmt_num(saved)} tokens")
    speed_rows = [e for e in rows
                  if e.get("tok_s") is not None or e.get("ttft_ms") is not None]
    if speed_rows:
        speeds = [e["tok_s"] for e in speed_rows if e.get("tok_s") is not None]
        ttfts = [e["ttft_ms"] for e in speed_rows if e.get("ttft_ms") is not None]
        parts = []
        if speeds:
            parts.append(f"median {int(round(_median(speeds)))} tok/s decode")
        if ttfts:
            parts.append(f"median {_median(ttfts) / 1000:.1f}s first token")
        print(f"speed: {' · '.join(parts)} ({len(speed_rows)} rounds)")
    print("estimate: input-equivalent tokens Claude would have spent doing it itself (cache reads weighted 0.1×), minus what it read from ds")


def _tool_short(part):
    nm = part.get("name") or part.get("tool") or "tool"
    inp = (part.get("state") or {}).get("input") or {}
    detail = (inp.get("command") or inp.get("path") or inp.get("filePath")
              or inp.get("pattern") or "")
    detail = " ".join(str(detail).split())
    if len(detail) > 100:
        detail = detail[:100] + "…"
    return f"  ▸ {nm} {detail}".rstrip()


def _tool_output(part):
    st = part.get("state") or {}
    if isinstance(st.get("output"), str):
        out = st["output"]
    else:
        out = "\n".join(c.get("text", "") for c in (st.get("content") or [])
                        if isinstance(c, dict) and c.get("type") == "text")
    return out.splitlines()[:6]


def cmd_log(a):
    job = load(a.job)
    sid = job.get("session")
    if not sid:
        die(f"job {a.job} has no session to export")
    # opencode truncates a piped export at 320 KiB; a file redirect is complete.
    fd, tmp = tempfile.mkstemp(prefix="ds-export-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            r = subprocess.run(["opencode", "session", "export", sid],
                               stdout=out, stderr=subprocess.PIPE, text=True)
        if r.returncode:
            msg = (r.stderr or "").strip()
            if not msg:
                try:
                    with open(tmp, encoding="utf-8") as f:
                        msg = f.read().strip()[:500]
                except OSError:
                    pass
            print(msg or "session export failed", file=sys.stderr)
            sys.exit(1)
        try:
            with open(tmp, encoding="utf-8") as f:
                data = json.load(f)
        except ValueError as e:
            print(f"ds: could not parse session export: {e}", file=sys.stderr)
            sys.exit(1)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass
    for m in data.get("messages") or []:
        t = m.get("type")
        if t == "user":
            if a.tools_only:
                continue
            print("── user")
            print((m.get("text") or "")[:400])
        elif t == "assistant":
            blocks = []
            for part in m.get("content") or []:
                if part.get("type") == "text" and not a.tools_only:
                    blocks.append(("text", part.get("text") or ""))
                elif part.get("type") == "tool":
                    blocks.append(("tool", part))
            if not blocks:
                continue
            print("── worker")
            for kind, val in blocks:
                if kind == "text":
                    print(val)
                else:
                    print(_tool_short(val))
                    for ln in _tool_output(val):
                        print("    " + ln)


