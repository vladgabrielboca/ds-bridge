#!/usr/bin/env python3
"""ds - Claude -> OpenCode/DeepSeek execution bridge.

Claude plans and reviews; DeepSeek (OpenCode agent "worker") executes.
The bridge itself computes the diff from a shadow-git snapshot, so Claude
only ever reads: the worker's short report + a capped diff.

  ds run  [-C DIR] [-m MODEL] [-f FILE]... [--paths P ...]
          [--check CMD] [--fix-tries N] "task"      new job
  ds revise JOB "feedback" [--check CMD]           same session, keeps DeepSeek's context
  ds diff   JOB [--full] [PATH...]                 re-show diff (optionally full / per path)
  ds approve JOB                                   accept, drop snapshot
  ds reject  JOB                                   restore files to pre-job snapshot
  ds list                                          recent jobs
  ds stats [--days N | --all]                      token savings from the ledger
  ds log   JOB [--tools-only]                      readable session transcript

--paths limits the snapshot/diff/reject scope to those paths, relative to -C.

Every emit() appends one line to <STATE>/ledger.jsonl (tokens, emitted
characters, seconds, check result); ds stats totals it and estimates what
Claude would have read. A desktop notification is sent when a run or revise
finishes (config "notify", default true; at least "notify_min_s" seconds,
default 15).

--check runs CMD with bash -c in the job dir after every worker call. On a
non-zero exit (or a timeout, config check_timeout_s, default 600) the worker is
asked to fix the cause in the same session and the check is re-run, at most
fix_tries times (config "fix_tries", default 2; override with --fix-tries).
The job report shows PASS/FAIL, and the diff includes any auto-fix changes.
revise reuses the stored check unless --check replaces it.
"""
import hashlib, json, os, subprocess, sys, time, argparse, shutil, queue, threading, fcntl

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/share/ds-bridge")
JOBS = os.path.join(STATE, "jobs")
SHADOW = os.path.join(STATE, "shadow")
PROGRESS = os.path.join(STATE, "progress")
RUNNING = os.path.join(STATE, "running")
LEDGER = os.path.join(STATE, "ledger.jsonl")
TODAY = os.path.join(STATE, "today.json")
CONF = os.path.join(HOME, ".config/ds-bridge/config.json")
DEFAULTS = {"model": "opencode-go/deepseek-v4.1-flash", "agent": "worker",
            "max_diff_lines": 250, "max_report_chars": 1500, "timeout_s": 1800,
            "max_files": 20000, "big_file_mb": 5,
            "fix_tries": 2, "check_timeout_s": 600,
            "notify": True, "notify_min_s": 15}
EXCLUDES = ["node_modules/", ".venv/", "venv/", "__pycache__/", ".git/", "*.pyc",
            "media/", "*.mp4", "*.mkv", "*.mov", "*.wav", "*.mp3", "*.flac",
            "*.safetensors", "*.bin", "*.pt", "*.pth", "*.ckpt", "*.gguf", "*.onnx",
            "*.zip", "*.tar*", "*.iso", ".cache/", "dist/", "build/", ".next/"]


def cfg():
    c = dict(DEFAULTS)
    try:
        c.update(json.load(open(CONF)))
    except FileNotFoundError:
        pass
    return c


def die(msg, code=2):
    print(f"ds: {msg}", file=sys.stderr)
    sys.exit(code)


def git(job_or_gd, wt, *args, check=True, capture=True, index=None):
    gd = job_or_gd
    env = os.environ.copy()
    if index:
        env["GIT_INDEX_FILE"] = index
    r = subprocess.run(["git", f"--git-dir={gd}", f"--work-tree={wt}", *args],
                       capture_output=capture, text=True, cwd=wt, env=env)
    if check and r.returncode:
        die(f"git {' '.join(args)} failed: {r.stderr.strip()[:500]}")
    return r.stdout if capture else ""


def job_index(jid):
    return os.path.join(JOBS, jid, "index")


def shadow_for(d):
    gd = os.path.join(SHADOW, hashlib.sha1(d.encode()).hexdigest()[:16])
    os.makedirs(SHADOW, exist_ok=True)
    # Serialize first-time setup so two concurrent jobs cannot race git init.
    with open(gd + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not os.path.isdir(gd):
            os.makedirs(gd)
            subprocess.run(["git", "init", "-q", "--bare", gd], check=True)
            for k, v in [("core.bare", "false"), ("user.name", "ds-bridge"),
                         ("user.email", "ds-bridge@localhost"), ("core.autocrlf", "false"),
                         ("gc.auto", "0")]:
                subprocess.run(["git", f"--git-dir={gd}", "config", k, v], check=True)
        os.makedirs(os.path.join(gd, "info"), exist_ok=True)
    return gd


def write_exclude(gd, ex):
    p = os.path.join(gd, "info/exclude")
    tmp = p + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write("\n".join(ex) + "\n")
    os.replace(tmp, p)


def snapshot(d, gd, label, index, jid, paths=None):
    c = cfg()
    ex = list(EXCLUDES)
    # skip big files so snapshots stay fast/small
    r = subprocess.run(["find", ".", "-path", "./.git", "-prune", "-o", "-type", "f",
                        "-size", f"+{c['big_file_mb']}M", "-print"],
                       capture_output=True, text=True, cwd=d)
    ex += ["/" + p[2:] for p in r.stdout.splitlines() if p.startswith("./")]
    write_exclude(gd, ex)
    if paths:
        git(gd, d, "add", "-A", "--", *paths, index=index)
    else:
        git(gd, d, "add", "-A", index=index)
    n = len(git(gd, d, "ls-files", index=index).splitlines())
    if n > c["max_files"]:
        die(f"{d} has {n} tracked files (> {c['max_files']}); run in a smaller directory")
    tree = git(gd, d, "write-tree", index=index).strip()
    commit = git(gd, d, "commit-tree", tree, "-m", label, index=index).strip()
    git(gd, d, "update-ref", f"refs/ds/{jid}/{label.replace(' ', '')}", commit, index=index)
    return commit


def norm_paths(paths):
    if not paths:
        return None
    out = []
    for p in paths:
        q = os.path.normpath(p).replace(os.sep, "/")
        if os.path.isabs(q) or q == "." or q == ".." or q.startswith("../"):
            die(f"--paths must be relative to the -C directory: {p}")
        if q not in out:
            out.append(q)
    return out


def pid_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def paths_overlap(a, b):
    if a is None or b is None:
        return True
    for x in a:
        for y in b:
            x, y = x.rstrip("/"), y.rstrip("/")
            if x == y or x.startswith(y + "/") or y.startswith(x + "/"):
                return True
    return False


def check_overlap(d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    for name in sorted(os.listdir(RUNNING)):
        if not name.endswith(".json"):
            continue
        p = os.path.join(RUNNING, name)
        try:
            m = json.load(open(p))
        except (OSError, ValueError):
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        if not pid_alive(m.get("pid")):
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        if os.path.realpath(m.get("dir", "")) == d and paths_overlap(m.get("paths"), paths):
            other = name[:-5]
            die(f"job {other} is already running in {d}; wait for it or use disjoint --paths")


def write_marker(jid, d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    p = os.path.join(RUNNING, jid + ".json")
    tmp = p + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"dir": d, "paths": paths, "pid": os.getpid()}, f)
    os.replace(tmp, p)


def clear_marker(jid):
    try:
        os.remove(os.path.join(RUNNING, jid + ".json"))
    except OSError:
        pass


def claim_job(jid, d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    with open(os.path.join(RUNNING, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        check_overlap(d, paths)
        write_marker(jid, d, paths)


def new_job_id():
    base = time.strftime("%m%d-%H%M%S")
    n = 0
    while True:
        jid = base if n == 0 else f"{base}-{n}"
        try:
            os.makedirs(os.path.join(JOBS, jid))
            return jid
        except FileExistsError:
            n += 1


def cleanup_progress():
    try:
        names = os.listdir(PROGRESS)
    except OSError:
        return
    cutoff = time.time() - 86400
    for name in names:
        p = os.path.join(PROGRESS, name)
        try:
            if os.path.getmtime(p) < cutoff:
                os.remove(p)
        except OSError:
            pass


def run_opencode(d, msg, model, agent, session=None, files=(), job=None):
    c = cfg()
    cmd = ["opencode", "run", "--format", "json", "--auto", "--agent", agent, "-m", model]
    if session:
        cmd += ["-s", session]
    for f in files:
        cmd += ["-f", f]
    cmd.append(msg)
    t0 = time.time()
    sid, texts, errors = session, [], []
    tok = {"input": 0, "output": 0, "cache_read": 0}
    cost, tools, steps = 0.0, 0, 0
    last = "thinking"
    cur_msg, cur_text = None, []
    gen_tokens, gen_ms_total = 0, 0
    step_window, step_tool_ms = None, 0

    def tok_s():
        return round(gen_tokens / (gen_ms_total / 1000)) if gen_ms_total else None

    def write_progress(state, **extra):
        obj = {"state": state, "job": job["id"], "round": job["round"], "model": model,
               "dir": os.path.basename(d), "started": t0, "updated": time.time(),
               "steps": steps, "tools": tools, "last": last,
               "out_tokens": tok["output"], "tok_s": tok_s()}
        obj.update(extra)
        try:
            os.makedirs(PROGRESS, exist_ok=True)
            path = os.path.join(PROGRESS, job["id"] + ".json")
            tmp = path + f".tmp.{os.getpid()}"
            with open(tmp, "w") as f:
                json.dump(obj, f)
            os.replace(tmp, path)
        except OSError:
            pass

    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, text=True, cwd=d)
    q = queue.Queue()

    def _reader():
        try:
            for line in p.stdout:
                q.put(line)
        finally:
            q.put(None)

    threading.Thread(target=_reader, daemon=True).start()
    timed_out = False
    while True:
        if time.time() - t0 > c["timeout_s"]:
            timed_out = True
            p.kill()
            break
        try:
            line = q.get(timeout=0.5)
        except queue.Empty:
            continue
        if line is None:
            break
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        sid = ev.get("sessionID", sid)
        t, part = ev.get("type"), ev.get("part") or {}
        ts = ev.get("timestamp")
        if t == "step_start":
            steps += 1
            step_window, step_tool_ms = ts, 0
            if tools == 0:
                last = "thinking"
        for st in ((part.get("time") or {}).get("start"),
                   ((part.get("state") or {}).get("time") or {}).get("start")):
            if st is not None and (step_window is None or st < step_window):
                step_window = st
        if t == "text":
            if part.get("messageID") != cur_msg:
                cur_msg, cur_text = part.get("messageID"), []
                texts.append(cur_text)
            cur_text.append(part.get("text", ""))
        elif t in ("tool_use", "tool"):
            tools += 1
            nm = part.get("tool") or "tool"
            stt = (part.get("state") or {}).get("time") or {}
            if stt.get("start") is not None and stt.get("end") is not None:
                step_tool_ms += stt["end"] - stt["start"]
            inp = (part.get("state") or {}).get("input") or {}
            if nm == "shell":
                detail = inp.get("command") or ""
            else:
                detail = inp.get("path") or inp.get("filePath") or inp.get("pattern") or ""
            last = " ".join(f"{nm} {detail}".split())[:60]
        elif t == "step_finish":
            tk = part.get("tokens") or {}
            tok["input"] += tk.get("input", 0)
            tok["output"] += tk.get("output", 0) + tk.get("reasoning", 0)
            tok["cache_read"] += (tk.get("cache") or {}).get("read", 0)
            cost += part.get("cost") or 0
            if step_window is not None and ts is not None:
                gen_ms = ts - step_window - step_tool_ms
                if gen_ms >= 200:
                    gen_tokens += tk.get("output", 0) + tk.get("reasoning", 0)
                    gen_ms_total += gen_ms
        elif t == "error":
            errors.append((ev.get("error") or {}).get("message", "unknown error"))
        write_progress("running")
    p.wait()
    if timed_out:
        errors.append(f"timeout after {int(c['timeout_s'])}s")
    final = "".join(texts[-1]).strip() if texts else ""
    secs = round(time.time() - t0)
    write_progress("error" if errors else "done", updated=time.time(), secs=secs)
    return {"session": sid, "report": final, "errors": errors, "tokens": tok,
            "cost": cost, "tools": tools, "secs": secs, "tok_s": tok_s()}


def write_progress_file(job, model, **fields):
    path = os.path.join(PROGRESS, job["id"] + ".json")
    try:
        obj = json.load(open(path))
    except (OSError, ValueError):
        obj = {"state": "running", "started": time.time(), "steps": 0, "tools": 0,
               "out_tokens": 0, "tok_s": None, "job": job["id"], "round": job["round"],
               "model": model, "dir": os.path.basename(job["dir"])}
    obj.update(fields)
    obj["updated"] = time.time()
    try:
        os.makedirs(PROGRESS, exist_ok=True)
        tmp = path + f".tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(obj, f)
        os.replace(tmp, path)
    except OSError:
        pass


def write_check_progress(job, model, cmd):
    write_progress_file(job, model, state="running", last="check: " + cmd[:40])


def run_check(d, cmd, timeout_s):
    """Run cmd with bash -c in d; return pass flag, exit code and last 60 lines."""
    try:
        r = subprocess.run(["bash", "-c", cmd], cwd=d, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True, timeout=timeout_s)
        out, code = r.stdout or "", r.returncode
    except subprocess.TimeoutExpired as e:
        out = e.stdout or ""
        if isinstance(out, bytes):
            out = out.decode(errors="replace")
        out += f"\n[check timed out after {timeout_s}s]"
        code = 124
    lines = out.splitlines()
    return {"pass": code == 0, "code": code, "output": "\n".join(lines[-60:])}


def run_with_check(job, msg, session=None, files=()):
    """Run the worker, then keep auto-fixing until the job's check passes."""
    d = job["dir"]
    res = run_opencode(d, msg, job["model"], job["agent"], session=session, files=files, job=job)
    if res["errors"]:
        return res
    check = job.get("check")
    if not check:
        return res
    tries = max(0, int(job.get("fix_tries") or 0))
    timeout_s = cfg()["check_timeout_s"]
    results, rounds = [res], 0
    while True:
        write_check_progress(job, job["model"], check)
        chk = run_check(d, check, timeout_s)
        if chk["pass"] or rounds >= tries:
            break
        rounds += 1
        fmsg = (f"AUTOMATED CHECK FAILED (not the reviewer). Command: {check}\n"
                f"Exit: {chk['code']}\nLast output lines:\n{chk['output']}\n"
                "Fix the cause within the original task scope, then reply with the "
                "final report block.")
        res = run_opencode(d, fmsg, job["model"], job["agent"],
                           session=res.get("session") or job.get("session"), job=job)
        results.append(res)
        if res["errors"]:
            return res
    last = results[-1]
    tok = {k: sum(r["tokens"].get(k, 0) for r in results)
           for k in ("input", "output", "cache_read")}
    out = dict(last)
    out["tokens"] = tok
    out["cost"] = sum(r.get("cost", 0) or 0 for r in results)
    out["secs"] = sum(r.get("secs", 0) or 0 for r in results)
    out["tok_s"] = last.get("tok_s")
    out["check"] = {"cmd": check, "pass": chk["pass"], "code": chk["code"],
                    "output": chk["output"], "rounds": rounds}
    write_progress_file(job, job["model"], state="error" if last["errors"] else "done",
                        last="check: " + ("pass" if chk["pass"] else "fail"),
                        secs=out["secs"], out_tokens=tok["output"], tok_s=out["tok_s"])
    return out


def diff_text(job, full=False, paths=(), since=None):
    d, gd = job["dir"], job["shadow"]
    idx = job_index(job["id"])
    job_paths = job.get("paths")
    if job_paths:
        git(gd, d, "add", "-A", "--", *job_paths, index=idx)
    else:
        git(gd, d, "add", "-A", index=idx)
    scope = list(paths) if paths else (job_paths or [])
    since = since or job["base"]
    stat = git(gd, d, "diff", "--cached", "--stat=100", since, "--", *scope, index=idx)
    body = git(gd, d, "diff", "--cached", "-U2", "--no-color", since, "--", *scope, index=idx)
    lines = body.splitlines()
    jdir = os.path.join(JOBS, job["id"])
    open(os.path.join(jdir, "full.diff"), "w").write(body)
    cap = cfg()["max_diff_lines"]
    if not full and len(lines) > cap:
        body = "\n".join(lines[:cap]) + (
            f"\n... [diff truncated: {len(lines) - cap} more lines. "
            f"`ds diff {job['id']} --full` or `ds diff {job['id']} <path>`; "
            f"file: {jdir}/full.diff]")
    return stat.strip(), body


def save(job):
    json.dump(job, open(os.path.join(JOBS, job["id"], "job.json"), "w"), indent=1)


def load(jid):
    p = os.path.join(JOBS, jid, "job.json")
    if not os.path.exists(p):
        die(f"no job {jid}")
    return json.load(open(p))


def fmt_num(n):
    """Format a token count as 1.2M / 340k / 912."""
    n = int(round(n))
    sign = "-" if n < 0 else ""
    a = abs(n)
    if a >= 1_000_000:
        return f"{sign}{a / 1_000_000:.1f}M" if a < 10_000_000 else f"{sign}{a / 1_000_000:.0f}M"
    if a >= 1_000:
        return f"{sign}{a / 1_000:.1f}k" if a < 10_000 else f"{sign}{a / 1_000:.0f}k"
    return f"{sign}{a}"


def saved_tokens(worker_in, worker_cache, worker_out, claude_chars):
    return worker_in + 0.1 * worker_cache + worker_out - claude_chars / 4


def _entry_saved(e):
    return saved_tokens(int(e.get("worker_in") or 0),
                        int(e.get("worker_cache") or 0),
                        int(e.get("worker_out") or 0),
                        int(e.get("claude_chars") or 0))


def refresh_today():
    """Recompute today.json from the ledger (old formula values get corrected)."""
    today = time.strftime("%Y-%m-%d")
    saved = jobs = 0
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                ts = e.get("ts") or 0
                try:
                    day = time.strftime("%Y-%m-%d", time.localtime(ts))
                except (OSError, ValueError, OverflowError):
                    continue
                if day != today:
                    continue
                saved += int(round(_entry_saved(e)))
                jobs += 1
    except OSError:
        pass
    try:
        tmp = TODAY + f".tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump({"date": today, "saved_tokens": saved, "jobs": jobs}, f)
        os.replace(tmp, TODAY)
    except OSError:
        pass


def record_ledger(job, res, claude_chars):
    tk = res["tokens"]
    entry = {"ts": int(time.time()), "job": job["id"], "round": job["round"],
             "dir": job["dir"], "worker_in": tk["input"],
             "worker_cache": tk["cache_read"], "worker_out": tk["output"],
             "claude_chars": claude_chars, "secs": res.get("secs"),
             "check": (None if not res.get("check")
                       else "pass" if res["check"]["pass"] else "fail")}
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, ".ledger.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with open(LEDGER, "a") as f:
                f.write(json.dumps(entry, separators=(",", ":")) + "\n")
            refresh_today()
    except Exception:
        pass


def emit(job, res):
    c = cfg()
    rep = res["report"] or "(worker gave no final report)"
    if len(rep) > c["max_report_chars"]:
        rep = rep[:c["max_report_chars"]] + " …[report truncated]"
    rb = job.get("round_base")
    stat, body = diff_text(job, since=rb)
    tk = res["tokens"]
    out = [f"JOB {job['id']}  round {job['round']}  dir {job['dir']}"]
    line = (f"worker: {job['model']}  {res['secs']}s  tok in {tk['input']} "
            f"(cache {tk['cache_read']}) out {tk['output']}  cost ${res['cost']:.4f}")
    if res.get("tok_s") is not None:
        line += f"  gen {res['tok_s']} tok/s"
    out.append(line)
    if res["errors"]:
        out.append("ERRORS: " + " | ".join(e[:300] for e in res["errors"]))
    out.append("--- report")
    out.append(rep)
    chk = res.get("check")
    if chk:
        out.append("--- check")
        if chk["pass"]:
            extra = f" (after {chk['rounds']} auto-fix rounds)" if chk["rounds"] > 0 else ""
            out.append(f"PASS  {chk['cmd']}{extra}")
        else:
            out.append(f"FAIL  {chk['cmd']}  exit {chk['code']}  "
                       f"after {chk['rounds']} auto-fix rounds")
            if chk["output"]:
                out.append("\n".join(chk["output"].splitlines()[-30:]))
    if rb:
        out.append(f"--- this round only (cumulative: ds diff {job['id']})")
    out.append("--- diff stat")
    out.append(stat.rstrip() or "(no changes)")
    if body:
        out.append("--- diff")
        out.append(body)
    out.append(f"--- next: ds approve {job['id']} | ds revise {job['id']} \"...\" | ds reject {job['id']}")
    text = "\n".join(out) + "\n"
    sys.stdout.write(text)
    record_ledger(job, res, len(text))


def notify_cmd(job, res):
    """Return the notify-send argv for a finished job, or None to stay quiet."""
    c = cfg()
    if not c.get("notify", True):
        return None
    try:
        min_s = int(c.get("notify_min_s", 15))
    except (TypeError, ValueError):
        min_s = 15
    secs = int(res.get("secs") or 0)
    if secs < min_s or not shutil.which("notify-send"):
        return None
    base = os.path.basename(job["dir"].rstrip("/")) or job["dir"]
    when = f"{secs // 60}:{secs % 60:02d}"
    errs = res.get("errors") or []
    if errs:
        title = f"DeepSeek {job['id']} failed"
        body = f"{base} · {when} · {str(errs[0])[:100]}"
    else:
        title = f"DeepSeek {job['id']} done"
        body = f"{base} · {when}"
        chk = res.get("check")
        if chk:
            body += " · check " + ("PASS" if chk["pass"] else "FAIL")
    return ["notify-send", "-a", "ds-bridge", title, body]


def notify_done(job, res):
    try:
        cmd = notify_cmd(job, res)
        if cmd:
            subprocess.run(cmd, timeout=5, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    except Exception:
        pass


def cmd_stats(a):
    now = time.time()
    if a.all:
        cutoff = None
    elif a.days is not None:
        cutoff = now - int(a.days) * 86400
    else:
        lt = time.localtime()
        cutoff = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1))
    rows = []
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if cutoff is None or e.get("ts", 0) >= cutoff:
                    rows.append(e)
    except OSError:
        pass
    win = sum(int(e.get("worker_in") or 0) for e in rows)
    wca = sum(int(e.get("worker_cache") or 0) for e in rows)
    wout = sum(int(e.get("worker_out") or 0) for e in rows)
    chars = sum(int(e.get("claude_chars") or 0) for e in rows)
    claude_tok = chars / 4
    saved = saved_tokens(win, wca, wout, chars)
    jobs = len({e.get("job") for e in rows if e.get("job")})
    print(f"jobs {jobs} · rounds {len(rows)}")
    print(f"worker tokens: in {fmt_num(win)} / cache {fmt_num(wca)} / out {fmt_num(wout)}")
    print(f"Claude read: {fmt_num(chars)} chars ≈ {fmt_num(claude_tok)} tokens")
    print(f"est. saved: ≈ {fmt_num(saved)} tokens")
    print("estimate: input-equivalent tokens Claude would have spent doing it itself (cache reads weighted 0.1×), minus what it read from ds")


def _tool_short(part):
    nm = part.get("name") or part.get("tool") or "tool"
    inp = (part.get("state") or {}).get("input") or {}
    detail = (inp.get("command") or inp.get("path") or inp.get("filePath")
              or inp.get("pattern") or "")
    detail = " ".join(str(detail).split())
    if len(detail) > 100:
        detail = detail[:100] + "…"
    return f"  ▸ {nm} {detail}".rstrip()


def _tool_output(part):
    st = part.get("state") or {}
    if isinstance(st.get("output"), str):
        out = st["output"]
    else:
        out = "\n".join(c.get("text", "") for c in (st.get("content") or [])
                        if isinstance(c, dict) and c.get("type") == "text")
    return out.splitlines()[:6]


def cmd_log(a):
    job = load(a.job)
    sid = job.get("session")
    if not sid:
        die(f"job {a.job} has no session to export")
    r = subprocess.run(["opencode", "session", "export", sid],
                       capture_output=True, text=True)
    if r.returncode:
        msg = (r.stderr or "").strip() or (r.stdout or "").strip() or "session export failed"
        print(msg, file=sys.stderr)
        sys.exit(1)
    try:
        data = json.loads(r.stdout)
    except ValueError as e:
        print(f"ds: could not parse session export: {e}", file=sys.stderr)
        sys.exit(1)
    for m in data.get("messages") or []:
        t = m.get("type")
        if t == "user":
            if a.tools_only:
                continue
            print("── user")
            print((m.get("text") or "")[:400])
        elif t == "assistant":
            blocks = []
            for part in m.get("content") or []:
                if part.get("type") == "text" and not a.tools_only:
                    blocks.append(("text", part.get("text") or ""))
                elif part.get("type") == "tool":
                    blocks.append(("tool", part))
            if not blocks:
                continue
            print("── worker")
            for kind, val in blocks:
                if kind == "text":
                    print(val)
                else:
                    print(_tool_short(val))
                    for ln in _tool_output(val):
                        print("    " + ln)


def cmd_run(a):
    c = cfg()
    d = os.path.realpath(a.C or os.getcwd())
    if d in (HOME, "/"):
        die("refusing to run in $HOME or / ; pass -C <project dir>")
    task = a.task if a.task != "-" else sys.stdin.read()
    paths = norm_paths(a.paths)
    os.makedirs(JOBS, exist_ok=True)
    jid = new_job_id()
    gd = shadow_for(d)
    try:
        claim_job(jid, d, paths)
    except SystemExit:
        try:
            os.rmdir(os.path.join(JOBS, jid))
        except OSError:
            pass
        raise
    try:
        base = snapshot(d, gd, f"pre {jid}", job_index(jid), jid, paths)
        job = {"id": jid, "dir": d, "shadow": gd, "base": base, "model": a.m or c["model"],
               "agent": c["agent"], "session": None, "round": 1, "status": "open",
               "paths": paths, "task": task[:2000], "check": a.check,
               "fix_tries": a.fix_tries if a.fix_tries is not None else c["fix_tries"]}
        save(job)
        res = run_with_check(job, task, files=a.f or ())
        job["session"] = res["session"]
        save(job)
        emit(job, res)
        notify_done(job, res)
    finally:
        clear_marker(jid)
        cleanup_progress()


def cmd_revise(a):
    job = load(a.job)
    if job["status"] != "open":
        die(f"job {a.job} is {job['status']}")
    paths = job.get("paths")
    claim_job(job["id"], job["dir"], paths)
    try:
        job["round"] += 1
        job["round_base"] = snapshot(job["dir"], job["shadow"], f"{job['id']} r{job['round']}",
                                     job_index(job["id"]), job["id"], paths)
        if a.check is not None:
            job["check"] = a.check
        msg = ("REVIEW FEEDBACK - revise your work. Fix exactly these points, nothing else, "
               "then reply with the same final report block (describe only this round's changes):\n"
               + (a.feedback if a.feedback != "-" else sys.stdin.read()))
        res = run_with_check(job, msg, session=job["session"])
        save(job)
        emit(job, res)
        notify_done(job, res)
    finally:
        clear_marker(job["id"])
        cleanup_progress()


def cmd_diff(a):
    job = load(a.job)
    stat, body = diff_text(job, full=a.full, paths=a.paths)
    print(stat.rstrip() or "(no changes)")
    print(body)


def cmd_approve(a):
    job = load(a.job)
    job["status"] = "approved"
    save(job)
    print(f"approved {a.job}")


def cmd_reject(a):
    job = load(a.job)
    d, gd = job["dir"], job["shadow"]
    idx = job_index(job["id"])
    paths = job.get("paths")
    if paths:
        git(gd, d, "add", "-A", "--", *paths, index=idx)
    else:
        git(gd, d, "add", "-A", index=idx)
    # files created since snapshot -> remove; changed/deleted -> restore
    diff_args = ["diff", "--cached", "--name-only", "--diff-filter=A", job["base"]]
    if paths:
        diff_args += ["--", *paths]
    added = [f for f in git(gd, d, *diff_args, index=idx).split("\n") if f]
    for f in added:
        try:
            os.remove(os.path.join(d, f))
        except OSError:
            pass
    if paths:
        # New paths are absent from base; check out only paths that base has.
        base_paths = [f for f in git(gd, d, "ls-tree", "-r", "--name-only",
                                    job["base"], "--", *paths, index=idx).split("\n") if f]
        if base_paths:
            git(gd, d, "checkout", job["base"], "--", *base_paths, index=idx)
    else:
        git(gd, d, "checkout", job["base"], "--", ".", index=idx)
    job["status"] = "rejected"
    save(job)
    print(f"rejected {a.job}: restored {d} to pre-job state ({len(added)} new files removed)")


def cmd_list(a):
    if not os.path.isdir(JOBS):
        return
    for jid in sorted(os.listdir(JOBS))[-15:]:
        try:
            j = load(jid)
        except SystemExit:
            continue
        print(f"{jid}  {j['status']:8}  r{j['round']}  {j['dir']}  {j['task'][:60]!r}")


def main():
    p = argparse.ArgumentParser(prog="ds", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    r = s.add_parser("run"); r.add_argument("-C"); r.add_argument("-m")
    r.add_argument("-f", action="append"); r.add_argument("--paths", nargs="+")
    r.add_argument("--check"); r.add_argument("--fix-tries", type=int)
    r.add_argument("task", nargs="?")
    r.set_defaults(fn=cmd_run)
    r = s.add_parser("revise"); r.add_argument("job"); r.add_argument("feedback")
    r.add_argument("--check"); r.set_defaults(fn=cmd_revise)
    r = s.add_parser("diff"); r.add_argument("job"); r.add_argument("--full", action="store_true")
    r.add_argument("paths", nargs="*"); r.set_defaults(fn=cmd_diff)
    for n, f in [("approve", cmd_approve), ("reject", cmd_reject)]:
        r = s.add_parser(n); r.add_argument("job"); r.set_defaults(fn=f)
    s.add_parser("list").set_defaults(fn=cmd_list)
    r = s.add_parser("stats"); r.add_argument("--days", type=int)
    r.add_argument("--all", action="store_true"); r.set_defaults(fn=cmd_stats)
    r = s.add_parser("log"); r.add_argument("job")
    r.add_argument("--tools-only", action="store_true"); r.set_defaults(fn=cmd_log)
    a = p.parse_args()
    if a.cmd == "run" and a.task is None:
        # --paths uses nargs="+"; when it comes before the task, argparse
        # greedily takes the task too. The task is the last value it took.
        if a.paths and len(a.paths) > 1:
            a.task = a.paths.pop()
        else:
            die("missing task (pass a string or - for stdin)")
    a.fn(a)


if __name__ == "__main__":
    main()
