_CONFIG_CACHE = None


def cfg():
    global _CONFIG_CACHE
    if _CONFIG_CACHE is not None:
        return _CONFIG_CACHE
    c = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            data = json.load(f)
    except FileNotFoundError:
        _CONFIG_CACHE = c
        return c
    except ValueError as e:
        die(f"config.json invalid: {e}")
    except OSError as e:
        die(f"config.json invalid: {e}")
    if not isinstance(data, dict):
        die("config.json invalid: top-level value must be an object")
    c.update(data)
    _CONFIG_CACHE = c
    return c


def die(msg, code=2):
    print(f"ds: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- brief lint
PLAYBOOK = os.path.join(os.path.dirname(os.path.realpath(__file__)), "planner-playbook.md")
BRIEF_SECTIONS = ["GOAL", "CONTEXT", "FILES", "STEPS", "DO NOT", "DONE WHEN"]
BRIEF_REQUIRED = ["GOAL", "FILES", "STEPS", "DO NOT", "DONE WHEN"]
# phrases that leave a decision to the worker; each is refused outside backticks and DO NOT
VAGUE_WORDS = [r"\betc\b", r"\band so on\b", r"\bas needed\b", r"\bif needed\b",
               r"\bif necessary\b", r"\bappropriate(ly)?\b", r"\bsomething like\b",
               r"\band the like\b", r"\bwhatever\b", r"\bclean(\s|-)?up\b", r"\bimprove\b",
               r"\bhandle (it )?properly\b", r"\bmake sure it works\b", r"\bsimilar to\b",
               r"\bor so\b", r"\bsomehow\b", r"\bfigure out\b", r"\bas you see fit\b",
               r"\bmaybe\b", r"\bperhaps\b", r"\bsome kind of\b", r"\bnice\b"]
# "GOAL: text", "GOAL:" or a bare "GOAL" line (optionally "## GOAL" / "**GOAL**") all count
_HEAD = re.compile(r"^[ \t]*(?:#+[ \t]*)?\**[ \t]*(" + "|".join(BRIEF_SECTIONS)
                   + r")[ \t]*\**[ \t]*(?::|$)", re.M)


def playbook_text():
    try:
        with open(PLAYBOOK) as f:
            return f.read()
    except OSError:
        return "(planner-playbook.md not found next to ds)"


def brief_template():
    t = playbook_text()
    m = re.search(r"## Writing the brief.*?```\n(.*?)```", t, re.S)
    return m.group(1).rstrip() if m else t


def brief_sections(task):
    """{section: text} for the sectioned brief."""
    out, heads = {}, list(_HEAD.finditer(task))
    for i, h in enumerate(heads):
        end = heads[i + 1].start() if i + 1 < len(heads) else len(task)
        out[h.group(1)] = task[h.end():end].strip()
    return out


def _vague(text):
    plain = re.sub(r"`[^`]*`", " ", text)          # exact strings may say anything
    found = []
    for pat in VAGUE_WORDS:
        for m in re.finditer(pat, plain, re.I):
            found.append(m.group(0))
    return sorted(set(w.lower() for w in found))


def lint_brief(task):
    """Problems with a run brief, [] if it may go to the worker."""
    c = cfg()
    probs = []
    if len(task.strip()) < c.get("brief_min_chars", 300):
        probs.append(f"too short ({len(task.strip())} chars, need {c.get('brief_min_chars', 300)}): "
                     "a self-contained brief names files, places, exact changes and checks")
    sec = brief_sections(task)
    for name in BRIEF_REQUIRED:
        if name not in sec:
            probs.append(f"missing section {name}:")
        elif not sec[name]:
            probs.append(f"section {name}: is empty")
    steps = sec.get("STEPS", "")
    if "STEPS" in sec and not re.search(r"^[ \t]*\d+[.)][ \t]", steps, re.M):
        probs.append("STEPS: needs numbered steps (1. 2. 3.), one action each")
    rest = "\n".join(v for k, v in sec.items() if k != "DO NOT") if sec else task
    words = _vague(rest)
    if words:
        probs.append("vague words (decide it and write it out): " + ", ".join(repr(w) for w in words))
    return probs


def lint_feedback(text):
    probs = []
    if not re.search(r"^[ \t]*\d+[.)][ \t]", text, re.M):
        probs.append("feedback needs numbered points (1. 2. ...), each naming the step, "
                     "the file and place, and the exact correction")
    words = _vague(text)
    if words:
        probs.append("vague words (write the exact correction): " + ", ".join(repr(w) for w in words))
    return probs


def refuse_brief(kind, probs):
    msg = [f"brief refused ({kind}); nothing was run.", *("  - " + p for p in probs)]
    if kind == "run":
        msg += ["", "Template:", brief_template()]
    msg += ["", "Full rules: ds playbook"]
    print("\n".join(msg), file=sys.stderr)
    sys.exit(2)


def install_signal_handlers():
    """Turn SIGTERM/SIGHUP into SystemExit so run/revise finally blocks run."""
    def _exit(signum, frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, _exit)
        except (ValueError, OSError):
            pass


def git(job_or_gd, wt, *args, check=True, capture=True, index=None):
    gd = job_or_gd
    env = os.environ.copy()
    if index:
        env["GIT_INDEX_FILE"] = index
    # a landed copy job's folder is gone; commit-to-commit diffs only need the shadow repo
    r = subprocess.run(["git", "-c", "core.quotePath=false",
                        f"--git-dir={gd}", f"--work-tree={wt}", *args],
                       capture_output=capture, text=True, cwd=wt if os.path.isdir(wt) else gd, env=env)
    if check and r.returncode:
        die(f"git {' '.join(args)} failed: {r.stderr.strip()[:500]}")
    return r.stdout if capture else ""


def job_index(jid):
    return os.path.join(JOBS, jid, "index")


def maybe_shadow_gc(gd):
    """Start a detached gc at most once per 24 h per shadow repo."""
    stamp = os.path.join(gd, "ds-gc-stamp")
    lock = stamp + ".lock"
    now = time.time()
    try:
        with open(lock, "w") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX)
            try:
                if now - os.path.getmtime(stamp) < 86400:
                    return
            except OSError:
                pass
            try:
                subprocess.Popen(["git", "-c", "core.quotePath=false",
                                  f"--git-dir={gd}", "gc", "--quiet",
                                  "--prune=1.hour.ago"],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            except OSError:
                return
            try:
                with open(stamp, "a"):
                    os.utime(stamp, (now, now))
            except OSError:
                pass
    except OSError:
        pass


def cleanup_shadow(job):
    """Drop the job's refs and index, then opportunistically gc the shadow repo."""
    gd, jid = job.get("shadow"), job["id"]
    if gd and os.path.isdir(gd):
        try:
            r = subprocess.run(["git", "-c", "core.quotePath=false",
                                f"--git-dir={gd}", "for-each-ref",
                                "--format=%(refname)", f"refs/ds/{jid}/"],
                               capture_output=True, text=True)
            for ref in r.stdout.splitlines():
                ref = ref.strip()
                if ref:
                    subprocess.run(["git", "-c", "core.quotePath=false",
                                    f"--git-dir={gd}", "update-ref", "-d", ref],
                                   capture_output=True)
        except OSError:
            pass
        maybe_shadow_gc(gd)
    try:
        os.remove(job_index(jid))
    except OSError:
        pass


def shadow_for(d):
    gd = os.path.join(SHADOW, hashlib.sha1(d.encode()).hexdigest()[:16])
    os.makedirs(SHADOW, exist_ok=True)
    # Serialize first-time setup so two concurrent jobs cannot race git init.
    with open(gd + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not os.path.isdir(gd):
            os.makedirs(gd)
            subprocess.run(["git", "init", "-q", "--bare", gd], check=True)
            for k, v in [("core.bare", "false"), ("user.name", "ds-bridge"),
                         ("user.email", "ds-bridge@localhost"), ("core.autocrlf", "false"),
                         ("gc.auto", "0")]:
                subprocess.run(["git", f"--git-dir={gd}", "config", k, v], check=True)
        os.makedirs(os.path.join(gd, "info"), exist_ok=True)
    return gd


def write_exclude(gd, ex):
    p = os.path.join(gd, "info/exclude")
    tmp = p + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write("\n".join(ex) + "\n")
    os.replace(tmp, p)


def stage_paths(gd, wt, paths, index):
    """Stage paths; missing paths that never existed are simply skipped."""
    if not paths:
        git(gd, wt, "add", "-A", index=index)
        return
    env = os.environ.copy()
    env["GIT_INDEX_FILE"] = index
    for p in paths:
        r = subprocess.run(["git", "-c", "core.quotePath=false",
                            f"--git-dir={gd}", f"--work-tree={wt}",
                            "add", "-A", "--", p],
                           capture_output=True, text=True, cwd=wt, env=env)
        if r.returncode and "did not match any files" not in (r.stderr or ""):
            die(f"git add {p} failed: {(r.stderr or '').strip()[:500]}")


def snapshot(d, gd, label, index, jid, paths=None):
    c = cfg()
    ex = list(EXCLUDES)
    # skip big files so snapshots stay fast/small
    env = dict(os.environ, PWD=d)
    r = subprocess.run(["find", ".", "-path", "./.git", "-prune", "-o", "-type", "f",
                        "-size", f"+{c['big_file_mb']}M", "-print"],
                       capture_output=True, text=True, cwd=d, env=env)
    ex += ["/" + p[2:] for p in r.stdout.splitlines() if p.startswith("./")]
    write_exclude(gd, ex)
    stage_paths(gd, d, paths, index)
    n = len([f for f in git(gd, d, "ls-files", "-z", index=index).split("\0") if f])
    if n > c["max_files"]:
        die(f"{d} has {n} tracked files (> {c['max_files']}); run in a smaller directory")
    tree = git(gd, d, "write-tree", index=index).strip()
    commit = git(gd, d, "commit-tree", tree, "-m", label, index=index).strip()
    git(gd, d, "update-ref", f"refs/ds/{jid}/{label.replace(' ', '')}", commit, index=index)
    return commit


def norm_paths(paths):
    if not paths:
        return None
    out = []
    for p in paths:
        q = os.path.normpath(p).replace(os.sep, "/")
        if os.path.isabs(q) or q == "." or q == ".." or q.startswith("../"):
            die(f"--paths must be relative to the -C directory: {p}")
        if q not in out:
            out.append(q)
    return out


def outside_ignored(rel, ignores):
    parts = rel.split("/")
    for pat in ignores:
        if fnmatch.fnmatch(rel, pat):
            return True
        if any(fnmatch.fnmatch(p, pat) for p in parts):
            return True
    return False


def under_paths(rel, paths):
    for p in paths:
        p = p.rstrip("/")
        if rel == p or rel.startswith(p + "/"):
            return True
    return False


def outside_listing(d, paths):
    """Cheap (size, mtime) listing of files outside the job's --paths."""
    ignores = cfg().get("outside_ignore") or []
    out = {}
    for root, dirs, names in os.walk(d):
        rel_root = os.path.relpath(root, d)
        dirs[:] = [x for x in dirs
                   if not outside_ignored((x if rel_root == "." else rel_root + "/" + x),
                                          ignores)]
        for name in names:
            rel = name if rel_root == "." else rel_root + "/" + name
            rel = rel.replace(os.sep, "/")
            if under_paths(rel, paths) or outside_ignored(rel, ignores):
                continue
            try:
                st = os.stat(os.path.join(root, name))
            except OSError:
                continue
            out[rel] = (st.st_size, st.st_mtime_ns)
    return out


def outside_changes(before, after):
    """Return capped lines for files created, changed or deleted outside --paths."""
    lines = []
    for rel in sorted(after):
        if rel not in before:
            lines.append(f"created {rel}")
        elif before[rel] != after[rel]:
            lines.append(f"changed {rel}")
    for rel in sorted(before):
        if rel not in after:
            lines.append(f"deleted {rel}")
    if len(lines) > 20:
        lines = lines[:19] + [f"… {len(lines) - 19} more"]
    return lines


def excluded_listing(d, paths):
    """Cheap (size, mtime_ns) listing for files that snapshots may skip.

    Dependency/cache directories are pruned, never entered. Files are listed
    here (not just pattern matches) so that a file that grew past
    big_file_mb is reported as changed rather than created; the reporter
    below keeps only excluded files.
    """
    out = {}
    for root, dirs, names in os.walk(d):
        dirs[:] = [x for x in dirs if x not in EXCLUDED_PRUNE]
        rel_root = os.path.relpath(root, d)
        for name in names:
            rel = name if rel_root == "." else rel_root + "/" + name
            rel = rel.replace(os.sep, "/")
            if paths and not under_paths(rel, paths):
                continue
            try:
                st = os.stat(os.path.join(root, name))
            except OSError:
                continue
            out[rel] = (st.st_size, st.st_mtime_ns)
    return out


def excluded_name(rel):
    """True when rel matches an EXCLUDES pattern."""
    parts = rel.split("/")
    name = parts[-1]
    for pat in EXCLUDES:
        if pat.endswith("/"):
            if pat[:-1] in parts:
                return True
        elif fnmatch.fnmatch(name, pat):
            return True
    return False


def excluded_note(before, after, c=None):
    """One tiny line summarising changes snapshots cannot see, or None."""
    c = c or cfg()
    if not c.get("excluded_note", True):
        return None
    try:
        big = float(c.get("big_file_mb", 5)) * 1024 * 1024
    except (TypeError, ValueError):
        big = 5 * 1024 * 1024
    groups = collections.defaultdict(lambda: [0, 0, 0])  # changed, created, deleted
    for rel in set(before) | set(after):
        b, a = before.get(rel), after.get(rel)
        if not excluded_name(rel) and not (b and b[0] > big) and not (a and a[0] > big):
            continue
        if b is None:
            kind = 1
        elif a is None:
            kind = 2
        elif b != a:
            kind = 0
        else:
            continue
        parts = rel.split("/")
        key = parts[0] + "/" if len(parts) > 1 else rel
        groups[key][kind] += 1
    if not groups:
        return None
    items = sorted(groups.items(), key=lambda kv: (-sum(kv[1]), kv[0]))
    bits = []
    for key, counts in items[:5]:
        seg = [key]
        for label, i in (("changed", 0), ("created", 1), ("deleted", 2)):
            if counts[i]:
                seg.append(f"{counts[i]} {label}")
        bits.append(" ".join(seg))
    line = "--- NOTE not in diff, not undoable by reject: " + " · ".join(bits)
    if len(items) > 5:
        line += f" · +{len(items) - 5} more groups"
    return line


def pid_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def paths_overlap(a, b):
    if a is None or b is None:
        return True
    for x in a:
        for y in b:
            x, y = x.rstrip("/"), y.rstrip("/")
            if x == y or x.startswith(y + "/") or y.startswith(x + "/"):
                return True
    return False


def check_overlap(d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    for name in sorted(os.listdir(RUNNING)):
        if not name.endswith(".json"):
            continue
        p = os.path.join(RUNNING, name)
        try:
            m = json.load(open(p))
        except (OSError, ValueError):
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        if not pid_alive(m.get("pid")):
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        if os.path.realpath(m.get("dir", "")) == d and paths_overlap(m.get("paths"), paths):
            other = name[:-5]
            die(f"job {other} is already running in {d}; wait for it or use disjoint --paths")


def write_marker(jid, d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    p = os.path.join(RUNNING, jid + ".json")
