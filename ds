def _apply_3way(gd, wt, patch, files, index):
    """3-way apply patch onto wt through a throwaway index synced to wt's current files.
    Returns (ok, output). The user's own git index is never touched."""
    try:
        os.remove(index)
    except OSError:
        pass
    present = [f for f in files if os.path.lexists(os.path.join(wt, f))]
    if present:
        git(gd, wt, "add", "-A", "-f", "--", *present, index=index)
    env = dict(os.environ, GIT_INDEX_FILE=index)
    base = ["git", "-c", "core.quotePath=false", f"--git-dir={gd}", f"--work-tree={wt}"]
    chk = subprocess.run(base + ["apply", "--3way", "--check", "-"], input=patch,
                         capture_output=True, text=True, cwd=wt, env=env)
    out = (chk.stdout or "") + (chk.stderr or "")
    # `apply --3way --check` exits 0 even when it would leave conflict markers
    if chk.returncode or "with conflicts" in out:
        return False, out.strip() or "patch does not apply"
    r = subprocess.run(base + ["apply", "--3way", "-"], input=patch,
                       capture_output=True, text=True, cwd=wt, env=env)
    return r.returncode == 0, ((r.stdout or "") + (r.stderr or "")).strip()


def _reverse(gd, wt, job):
    post = job.get("post") or job["base"]
    return git(gd, wt, "diff", "--binary", "--no-renames", post, job["base"])


def _job_patch(job):
    gd, w = job["shadow"], job["dir"]
    post = job.get("post") or job["base"]
    names = [f for f in git(gd, w, "diff", "--name-only", "-z", "--no-renames",
                            job["base"], post).split("\0") if f]
    patch = git(gd, w, "diff", "--binary", "--no-renames", job["base"], post) if names else ""
    return patch, names


def copy_back_untracked(job):
    """Files the job created or changed in its copy that snapshots skip (renders, media,
    big files): reflink them into the project. Returns (copied, skipped)."""
    w, d = job["dir"], job["project"]
    post = job.get("post") or job["base"]
    tracked = set(f for f in git(job["shadow"], w, "ls-tree", "-r", "-z", "--name-only",
                                 post).split("\0") if f)
    t0 = float(job.get("started") or 0)
    copied, skipped = 0, []
    for root, dirs, files in os.walk(w):
        dirs[:] = [x for x in dirs if x not in EXCLUDED_PRUNE]
        for name in files:
            src = os.path.join(root, name)
            rel = os.path.relpath(src, w)
            try:
                if rel in tracked or os.lstat(src).st_mtime <= t0:
                    continue
            except OSError:
                continue
            dst = os.path.join(d, rel)
            try:
                if os.path.lexists(dst) and os.lstat(dst).st_mtime > t0:
                    skipped.append(rel)   # changed in the project meanwhile: keep that
                    continue
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                subprocess.run(["cp", "-a", "--reflink=auto", src, dst], check=True,
                               capture_output=True)
                copied += 1
            except (OSError, subprocess.CalledProcessError):
                skipped.append(rel)
    return copied, skipped


def leftover_markers(job):
    """Files whose job changes still add conflict marker lines."""
    post = job.get("post") or job["base"]
    out = git(job["shadow"], job["dir"], "diff", "--check", job["base"], post, check=False)
    return sorted(set(re.findall(r"^(.+?):\d+: leftover conflict marker$", out, re.M)))


def land(job):
    """Apply a copied job's changes to the project. Returns None or the conflict text."""
    d, gd = job["project"], job["shadow"]
    patch, names = _job_patch(job)
    with open(gd + ".land.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if patch.strip():
            ok, out = _apply_3way(gd, d, patch, names,
                                  os.path.join(JOBS, job["id"], "land.index"))
            if not ok:
                return out
        job["copied_back"] = copy_back_untracked(job)
    return None


def cmd_approve(a):
    job = load(a.job)
    if job["status"] == "landed":
        job["status"] = "approved"
        save(job)
        cleanup_shadow(job)
        print(f"approved {a.job} (it had already landed)")
        return
    if job["status"] != "open":
        die(f"job {a.job} is {job['status']}; nothing to approve")
    extra = ""
    if job.get("project"):
        marked = leftover_markers(job)
        if marked:
            die(f"job {a.job} still has conflict markers in: {', '.join(marked)}; "
                f"ds revise {a.job} \"1. resolve the conflict markers in ...\" first")
        conflict = land(job)
        if conflict:
            print(f"CONFLICT {a.job}: its changes no longer apply cleanly to {job['project']}; "
                  "nothing was changed there.")
            print("\n".join(conflict.splitlines()[:15]))
            print(f"--- next: ds rebase {a.job} (fresh copy, conflict markers for the worker), "
                  f"then ds revise {a.job} \"1. resolve the conflict markers in ...\"; "
                  f"or ds reject {a.job}")
            sys.exit(1)
        n, skipped = job.get("copied_back") or (0, [])
        if n:
            extra += f"; copied back {n} untracked files (renders, media)"
        if skipped:
            extra += f"; kept the project's newer {len(skipped)}: " + ", ".join(skipped[:5])
        drop_copy(job)
        extra = f": landed in {job['project']}" + extra
    job["status"] = "approved"
    save(job)
    cleanup_shadow(job)
    print(f"approved {a.job}{extra}")


def rebase_job(job):
    """Fresh copy of the current project with the job's changes 3-way applied; returns the files left
    with conflict markers. The job now points at the new copy and base."""
    d, gd, jid = job["project"], job["shadow"], job["id"]
    patch, names = _job_patch(job)
    job["rebases"] = int(job.get("rebases") or 0) + 1
    w2, err = make_copy(d, f"{jid}-r{job['rebases']}")
    if not w2:
        die(f"could not make a fresh copy: {err}")
    old = job["dir"]
    base2 = snapshot(w2, gd, f"rebase {jid}", job_index(jid), jid, job.get("paths"))
    idx = os.path.join(JOBS, jid, "rebase.index")
    try:
        os.remove(idx)
    except OSError:
        pass
    present = [f for f in names if os.path.lexists(os.path.join(w2, f))]
    if present:
        git(gd, w2, "add", "-A", "-f", "--", *present, index=idx)
    r = subprocess.run(["git", "-c", "core.quotePath=false", f"--git-dir={gd}",
                        f"--work-tree={w2}", "apply", "--3way", "-"], input=patch,
                       capture_output=True, text=True, cwd=w2,
                       env=dict(os.environ, GIT_INDEX_FILE=idx))
    unmerged = git(gd, w2, "ls-files", "-u", "-z", index=idx, check=False).split("\0")
    conflicted = sorted(set(e.split("\t", 1)[1] for e in unmerged if "\t" in e))
    job.update(dir=w2, base=base2, round_base=None, started=time.time())
    job["post"] = snapshot(w2, gd, f"post rebase {jid}", job_index(jid), jid, job.get("paths"))
    save(job)
    if os.path.realpath(old).startswith(os.path.realpath(WORK) + os.sep):
        shutil.rmtree(old, ignore_errors=True)
    conflicted = sorted(set(conflicted) | set(leftover_markers(job)))
    job["_rebase_err"] = (r.stderr or "").strip()[:300] if r.returncode and not conflicted else ""
    return conflicted


def cmd_rebase(a):
    """Fresh copy of the project, then the job's changes 3-way applied onto it; clashing
    hunks stay as conflict markers for `ds revise` to resolve."""
    job = load(a.job)
    if job["status"] != "open" or not job.get("project"):
        die(f"job {a.job} is not an open job with a private copy")
    jid = job["id"]
    conflicted = rebase_job(job)
    err = job.pop("_rebase_err", "")
    save(job)
    if err and not conflicted:
        print(f"rebased {jid}: patch did not apply: {err}")
    elif conflicted:
        print(f"rebased {jid} onto the current project; conflict markers in: " + ", ".join(conflicted))
        print(f"--- next: ds revise {jid} \"1. In <file>, resolve the conflict markers: ...\"")
    else:
        print(f"rebased {jid} onto the current project; no conflicts. ds approve {jid}")


def commit_blob(gd, wt, commit, path):
    """Blob hash of path in commit, or "absent"."""
    out = git(gd, wt, "ls-tree", "-z", commit, "--", path).strip("\0\n")
    if not out:
        return "absent"
    parts = out.split("\t", 1)[0].split()
    if len(parts) >= 3 and parts[1] in ("blob", "commit"):
        return parts[2]
    return "absent"


def worktree_blob(gd, wt, path):
    """Blob hash of the current working file, or "absent"/"unreadable"."""
    if not os.path.lexists(os.path.join(wt, path)):
        return "absent"
    try:
        r = subprocess.run(["git", "-c", "core.quotePath=false",
                            f"--git-dir={gd}", f"--work-tree={wt}",
                            "hash-object", "--", path],
                           capture_output=True, text=True, cwd=wt)
    except OSError:
        return "unreadable"
    if r.returncode:
        return "unreadable"
    return r.stdout.strip()


def prune_empty_dirs(root, rel):
    """Remove parent dirs of rel left empty, never reaching root itself."""
    root = os.path.realpath(root)
    parent = os.path.dirname(rel.replace(os.sep, "/"))
    while parent and parent not in (".", ""):
        path = os.path.realpath(os.path.join(root, parent))
        if path == root or not path.startswith(root + os.sep):
            break
        try:
            os.rmdir(path)
        except OSError:
            break
        parent = os.path.dirname(parent)


def cmd_reject(a):
    job = load(a.job)
    if job["status"] == "landed" and job.get("project"):
        # undo a landed copy job: 3-way apply its patch in reverse to the project
        patch, names = _job_patch(job)
        d, gd = job["project"], job["shadow"]
        with open(gd + ".land.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            ok, out = _apply_3way(gd, d, _reverse(gd, d, job), names,
                                  os.path.join(JOBS, job["id"], "land.index")) if patch.strip() else (True, "")
        if not ok:
            die(f"could not undo {a.job}: the files changed since it landed:\n{out[:600]}")
        job["status"] = "rejected"
        save(job)
        cleanup_shadow(job)
        print(f"rejected {a.job}: its landed changes were undone in {d}")
        return
    if job["status"] == "landed":
        job["status"] = "open"   # in place: the normal restore below undoes it
    if job["status"] != "open":
        die(f"job {a.job} is {job['status']}; nothing to reject")
    if job.get("project"):
        drop_copy(job)
        job["status"] = "rejected"
        save(job)
        cleanup_shadow(job)
        print(f"rejected {a.job}: private copy deleted; {job['project']} was never changed")
        return
    d, gd = job["dir"], job["shadow"]
    idx = job_index(job["id"])
    paths = job.get("paths")
    if not job.get("post"):
        print(f"ds: warning: job {a.job} has no post-run snapshot; "
              "restoring the whole scope to the pre-job state")
        stage_paths(gd, d, paths, idx)
        # files created since snapshot -> remove; changed/deleted -> restore
        diff_args = ["diff", "--cached", "--name-only", "-z",
                     "--diff-filter=A", job["base"]]
        if paths:
            diff_args += ["--", *paths]
        added = [f for f in git(gd, d, *diff_args, index=idx).split("\0") if f]
        for f in added:
            try:
                os.remove(os.path.join(d, f))
            except OSError:
                pass
        if paths:
            # New paths are absent from base; check out only paths that base has.
            base_paths = [f for f in git(gd, d, "ls-tree", "-r", "-z", "--name-only",
                                        job["base"], "--", *paths, index=idx).split("\0") if f]
            if base_paths:
                git(gd, d, "checkout", job["base"], "--", *base_paths, index=idx)
        else:
            git(gd, d, "checkout", job["base"], "--", ".", index=idx)
        job["status"] = "rejected"
        save(job)
        cleanup_shadow(job)
        print(f"rejected {a.job}: restored {d} to pre-job state ({len(added)} new files removed)")
        return

    post = job["post"]
    diff_args = ["diff", "--name-status", "-z", "--no-renames", job["base"], post]
    if paths:
        diff_args += ["--", *paths]
    entries = [e for e in git(gd, d, *diff_args).split("\0") if e]
    files = [entries[i + 1] for i in range(0, len(entries) - 1, 2)
             if entries[i + 1]]

    restore, skipped = [], []
    for f in files:
        if worktree_blob(gd, d, f) == commit_blob(gd, d, post, f):
            restore.append(f)
        else:
            skipped.append(f)
    force = bool(getattr(a, "force", False))
    if force:
        restore += skipped
        skipped = []

    restored, removed = 0, []
    for f in restore:
        if commit_blob(gd, d, job["base"], f) == "absent":
            try:
                os.remove(os.path.join(d, f))
                removed.append(f)
            except OSError:
                pass
        else:
            git(gd, d, "checkout", job["base"], "--", f, index=idx)
            restored += 1
    for f in removed:
        prune_empty_dirs(d, f)

    job["status"] = "rejected"
    save(job)
    cleanup_shadow(job)
    print(f"rejected {a.job}: restored {restored}, removed {len(removed)} new files")
    if skipped:
        names = ", ".join(skipped[:10])
        if len(skipped) > 10:
            names += " …"
        print(f"skipped {len(skipped)} changed after the job (use --force): {names}")


def delegate_session(a):
    sid = a.session or os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    sid = sid.strip() if isinstance(sid, str) else ""
    if not sid:
        die("missing session id (pass --session ID or set CLAUDE_CODE_SESSION_ID)")
    return sid


def prune_delegates():
    now = time.time()
    try:
        names = os.listdir(DELEGATE)
    except OSError:
        return
    for name in names:
        path = os.path.join(DELEGATE, name)
        try:
            if os.path.isfile(path) and now - os.path.getmtime(path) > DELEGATE_TTL:
                os.remove(path)
        except OSError:
            pass


def cmd_delegate(a):
    sid = delegate_session(a)
    marker = os.path.join(DELEGATE, sid)
    if a.action == "status":
        print("delegation mode: " + ("on" if os.path.exists(marker) else "off"))
        return
    if a.action == "on":
        try:
            os.makedirs(DELEGATE, exist_ok=True)
            with open(marker, "a"):
                pass
        except OSError as e:
            die(f"cannot enable delegation for {sid}: {e}")
    else:
        try:
            os.remove(marker)
        except FileNotFoundError:
            pass
        except OSError as e:
            die(f"cannot disable delegation for {sid}: {e}")
    prune_delegates()
    print("delegation mode: " + ("on" if a.action == "on" else "off"))
    if a.action == "on":
        print("\nRead these rules now; every brief and revise follows them.\n")
        print(playbook_text())
        try:
            with open(marker, "w") as f:     # the hook then won't inject it a second time
                json.dump({"shown": True}, f)
        except OSError:
            pass


def cmd_playbook(a):
    print(playbook_text())


def cmd_list(a):
    if not os.path.isdir(JOBS):
        return
    for jid in sorted(os.listdir(JOBS))[-15:]:
        try:
            j = load(jid)
        except SystemExit:
            continue
        print(f"{jid}  {j['status']:8}  r{j['round']}  {j['dir']}  {j['task'][:60]!r}")


def main():
    install_signal_handlers()
    p = argparse.ArgumentParser(prog="ds", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    r = s.add_parser("run"); r.add_argument("-C"); r.add_argument("-m")
    r.add_argument("-f", action="append"); r.add_argument("--paths", nargs="+")
    r.add_argument("--check"); r.add_argument("--fix-tries", type=int)
    r.add_argument("--fix", action="store_true")
    r.add_argument("--files"); r.add_argument("--source"); r.add_argument("--brief")
    r.add_argument("--timeout", type=int)
    r.add_argument("task", nargs="?")
    r.set_defaults(fn=cmd_run)
    r = s.add_parser("init"); r.add_argument("-C")
    r.add_argument("--refresh", action="store_true")
    r.add_argument("--timeout", type=int); r.set_defaults(fn=cmd_init)
    r = s.add_parser("research"); r.add_argument("-C"); r.add_argument("-m")
    r.add_argument("-f", action="append"); r.add_argument("--paths", nargs="+")
    r.add_argument("--words", type=int); r.add_argument("--timeout", type=int)
    r.add_argument("question", nargs="?"); r.set_defaults(fn=cmd_research)
    r = s.add_parser("revise"); r.add_argument("job"); r.add_argument("feedback")
    r.add_argument("-f", action="append"); r.add_argument("--check"); r.add_argument("--timeout", type=int)
    r.set_defaults(fn=cmd_revise)
    r = s.add_parser("diff"); r.add_argument("job"); r.add_argument("--full", action="store_true")
    r.add_argument("paths", nargs="*"); r.set_defaults(fn=cmd_diff)
    r = s.add_parser("approve"); r.add_argument("job"); r.set_defaults(fn=cmd_approve)
    r = s.add_parser("rebase"); r.add_argument("job"); r.set_defaults(fn=cmd_rebase)
    r = s.add_parser("reply"); r.add_argument("job"); r.add_argument("answer")
    r.add_argument("--check"); r.add_argument("--timeout", type=int); r.add_argument("-f", action="append")
    r.set_defaults(fn=cmd_reply)
    r = s.add_parser("batch"); r.add_argument("-C"); r.add_argument("plan")
    r.add_argument("--steps"); r.add_argument("--check"); r.add_argument("--source")
    r.add_argument("--parallel", type=int); r.set_defaults(fn=cmd_batch)
    r = s.add_parser("wait"); r.add_argument("job"); r.add_argument("--max", type=int)
    r.set_defaults(fn=cmd_wait)
    r = s.add_parser("reject"); r.add_argument("job")
    r.add_argument("--force", action="store_true"); r.set_defaults(fn=cmd_reject)
    s.add_parser("list").set_defaults(fn=cmd_list)
    r = s.add_parser("stats"); r.add_argument("--days", type=int)
    r.add_argument("--all", action="store_true"); r.set_defaults(fn=cmd_stats)
    r = s.add_parser("log"); r.add_argument("job")
    r.add_argument("--tools-only", action="store_true"); r.set_defaults(fn=cmd_log)
    r = s.add_parser("delegate")
    r.add_argument("action", choices=["on", "off", "status"])
    r.add_argument("--session")
    r.set_defaults(fn=cmd_delegate)
    s.add_parser("playbook").set_defaults(fn=cmd_playbook)
    a = p.parse_args()
    if os.environ.get("DS_STDIN"):
        sys.stdin = open(os.environ["DS_STDIN"])
    if (a.cmd in ("run", "revise", "reply", "research", "batch") and not os.environ.get("DS_CHILD")
            and int(cfg().get("wait_s") or 0) > 0):
        sys.exit(detach_and_wait(sys.argv, int(cfg()["wait_s"])))
    if os.environ.get("DS_CHILD"):
        import atexit
        atexit.register(finish_child)
    if getattr(a, "f", None):
        # opencode resolves -f against the job dir ($PWD); make paths absolute
        # from the caller's cwd and refuse missing files before any job starts.
        a.f = [os.path.abspath(os.path.expanduser(f)) for f in a.f]
        for f in a.f:
            if not os.path.isfile(f):
                die(f"-f {f}: no such file")
    if a.cmd == "research" and a.question is None:
        if a.paths and len(a.paths) > 1:
            a.question = a.paths.pop()
        else:
            die("research needs a question (or - for stdin)")
    if a.cmd == "run" and a.task is None:
        # --paths uses nargs="+"; when it comes before the task, argparse
        # greedily takes the task too. The task is the last value it took.
        if a.paths and len(a.paths) > 1:
            a.task = a.paths.pop()
        else:
            die("missing task (pass a string or - for stdin)")
    a.fn(a)


if __name__ == "__main__":
    main()
