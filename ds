_CONFIG_CACHE = None


def cfg():
    global _CONFIG_CACHE
    if _CONFIG_CACHE is not None:
        return _CONFIG_CACHE
    c = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            data = json.load(f)
    except FileNotFoundError:
        _CONFIG_CACHE = c
        return c
    except ValueError as e:
        die(f"config.json invalid: {e}")
    except OSError as e:
        die(f"config.json invalid: {e}")
    if not isinstance(data, dict):
        die("config.json invalid: top-level value must be an object")
    c.update(data)
    _CONFIG_CACHE = c
    return c


def die(msg, code=2):
    print(f"ds: {msg}", file=sys.stderr)
    sys.exit(code)


def install_signal_handlers():
    """Turn SIGTERM/SIGHUP into SystemExit so run/revise finally blocks run."""
    def _exit(signum, frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, _exit)
        except (ValueError, OSError):
            pass


def git(job_or_gd, wt, *args, check=True, capture=True, index=None):
    gd = job_or_gd
    env = os.environ.copy()
    if index:
        env["GIT_INDEX_FILE"] = index
    r = subprocess.run(["git", "-c", "core.quotePath=false",
                        f"--git-dir={gd}", f"--work-tree={wt}", *args],
                       capture_output=capture, text=True, cwd=wt, env=env)
    if check and r.returncode:
        die(f"git {' '.join(args)} failed: {r.stderr.strip()[:500]}")
    return r.stdout if capture else ""


def job_index(jid):
    return os.path.join(JOBS, jid, "index")


def maybe_shadow_gc(gd):
    """Start a detached gc at most once per 24 h per shadow repo."""
    stamp = os.path.join(gd, "ds-gc-stamp")
    lock = stamp + ".lock"
    now = time.time()
    try:
        with open(lock, "w") as lf:
            fcntl.flock(lf, fcntl.LOCK_EX)
            try:
                if now - os.path.getmtime(stamp) < 86400:
                    return
            except OSError:
                pass
            try:
                subprocess.Popen(["git", "-c", "core.quotePath=false",
                                  f"--git-dir={gd}", "gc", "--quiet",
                                  "--prune=1.hour.ago"],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            except OSError:
                return
            try:
                with open(stamp, "a"):
                    os.utime(stamp, (now, now))
            except OSError:
                pass
    except OSError:
        pass


def cleanup_shadow(job):
    """Drop the job's refs and index, then opportunistically gc the shadow repo."""
    gd, jid = job.get("shadow"), job["id"]
    if gd and os.path.isdir(gd):
        try:
            r = subprocess.run(["git", "-c", "core.quotePath=false",
                                f"--git-dir={gd}", "for-each-ref",
                                "--format=%(refname)", f"refs/ds/{jid}/"],
                               capture_output=True, text=True)
            for ref in r.stdout.splitlines():
                ref = ref.strip()
                if ref:
                    subprocess.run(["git", "-c", "core.quotePath=false",
                                    f"--git-dir={gd}", "update-ref", "-d", ref],
                                   capture_output=True)
        except OSError:
            pass
        maybe_shadow_gc(gd)
    try:
        os.remove(job_index(jid))
    except OSError:
        pass


def shadow_for(d):
    gd = os.path.join(SHADOW, hashlib.sha1(d.encode()).hexdigest()[:16])
    os.makedirs(SHADOW, exist_ok=True)
    # Serialize first-time setup so two concurrent jobs cannot race git init.
    with open(gd + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not os.path.isdir(gd):
            os.makedirs(gd)
            subprocess.run(["git", "init", "-q", "--bare", gd], check=True)
            for k, v in [("core.bare", "false"), ("user.name", "ds-bridge"),
                         ("user.email", "ds-bridge@localhost"), ("core.autocrlf", "false"),
                         ("gc.auto", "0")]:
                subprocess.run(["git", f"--git-dir={gd}", "config", k, v], check=True)
        os.makedirs(os.path.join(gd, "info"), exist_ok=True)
    return gd


def write_exclude(gd, ex):
    p = os.path.join(gd, "info/exclude")
    tmp = p + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write("\n".join(ex) + "\n")
    os.replace(tmp, p)


def stage_paths(gd, wt, paths, index):
    """Stage paths; missing paths that never existed are simply skipped."""
    if not paths:
        git(gd, wt, "add", "-A", index=index)
        return
    env = os.environ.copy()
    env["GIT_INDEX_FILE"] = index
    for p in paths:
        r = subprocess.run(["git", "-c", "core.quotePath=false",
                            f"--git-dir={gd}", f"--work-tree={wt}",
                            "add", "-A", "--", p],
                           capture_output=True, text=True, cwd=wt, env=env)
        if r.returncode and "did not match any files" not in (r.stderr or ""):
            die(f"git add {p} failed: {(r.stderr or '').strip()[:500]}")


def snapshot(d, gd, label, index, jid, paths=None):
    c = cfg()
    ex = list(EXCLUDES)
    # skip big files so snapshots stay fast/small
    env = dict(os.environ, PWD=d)
    r = subprocess.run(["find", ".", "-path", "./.git", "-prune", "-o", "-type", "f",
                        "-size", f"+{c['big_file_mb']}M", "-print"],
                       capture_output=True, text=True, cwd=d, env=env)
    ex += ["/" + p[2:] for p in r.stdout.splitlines() if p.startswith("./")]
    write_exclude(gd, ex)
    stage_paths(gd, d, paths, index)
    n = len([f for f in git(gd, d, "ls-files", "-z", index=index).split("\0") if f])
    if n > c["max_files"]:
        die(f"{d} has {n} tracked files (> {c['max_files']}); run in a smaller directory")
    tree = git(gd, d, "write-tree", index=index).strip()
    commit = git(gd, d, "commit-tree", tree, "-m", label, index=index).strip()
    git(gd, d, "update-ref", f"refs/ds/{jid}/{label.replace(' ', '')}", commit, index=index)
    return commit


def norm_paths(paths):
    if not paths:
        return None
    out = []
    for p in paths:
        q = os.path.normpath(p).replace(os.sep, "/")
        if os.path.isabs(q) or q == "." or q == ".." or q.startswith("../"):
            die(f"--paths must be relative to the -C directory: {p}")
        if q not in out:
            out.append(q)
    return out


def outside_ignored(rel, ignores):
    parts = rel.split("/")
    for pat in ignores:
        if fnmatch.fnmatch(rel, pat):
            return True
        if any(fnmatch.fnmatch(p, pat) for p in parts):
            return True
    return False


def under_paths(rel, paths):
    for p in paths:
        p = p.rstrip("/")
        if rel == p or rel.startswith(p + "/"):
            return True
    return False


def outside_listing(d, paths):
    """Cheap (size, mtime) listing of files outside the job's --paths."""
    ignores = cfg().get("outside_ignore") or []
    out = {}
    for root, dirs, names in os.walk(d):
        rel_root = os.path.relpath(root, d)
        dirs[:] = [x for x in dirs
                   if not outside_ignored((x if rel_root == "." else rel_root + "/" + x),
                                          ignores)]
        for name in names:
            rel = name if rel_root == "." else rel_root + "/" + name
            rel = rel.replace(os.sep, "/")
            if under_paths(rel, paths) or outside_ignored(rel, ignores):
                continue
            try:
                st = os.stat(os.path.join(root, name))
            except OSError:
                continue
            out[rel] = (st.st_size, st.st_mtime_ns)
    return out


def outside_changes(before, after):
    """Return capped lines for files created, changed or deleted outside --paths."""
    lines = []
    for rel in sorted(after):
        if rel not in before:
            lines.append(f"created {rel}")
        elif before[rel] != after[rel]:
            lines.append(f"changed {rel}")
    for rel in sorted(before):
        if rel not in after:
            lines.append(f"deleted {rel}")
    if len(lines) > 20:
        lines = lines[:19] + [f"… {len(lines) - 19} more"]
    return lines


def excluded_listing(d, paths):
    """Cheap (size, mtime_ns) listing for files that snapshots may skip.

    Dependency/cache directories are pruned, never entered. Files are listed
    here (not just pattern matches) so that a file that grew past
    big_file_mb is reported as changed rather than created; the reporter
    below keeps only excluded files.
    """
    out = {}
    for root, dirs, names in os.walk(d):
        dirs[:] = [x for x in dirs if x not in EXCLUDED_PRUNE]
        rel_root = os.path.relpath(root, d)
        for name in names:
            rel = name if rel_root == "." else rel_root + "/" + name
            rel = rel.replace(os.sep, "/")
            if paths and not under_paths(rel, paths):
                continue
            try:
                st = os.stat(os.path.join(root, name))
            except OSError:
                continue
            out[rel] = (st.st_size, st.st_mtime_ns)
    return out


def excluded_name(rel):
    """True when rel matches an EXCLUDES pattern."""
    parts = rel.split("/")
    name = parts[-1]
    for pat in EXCLUDES:
        if pat.endswith("/"):
            if pat[:-1] in parts:
                return True
        elif fnmatch.fnmatch(name, pat):
            return True
    return False


def excluded_note(before, after, c=None):
    """One tiny line summarising changes snapshots cannot see, or None."""
    c = c or cfg()
    if not c.get("excluded_note", True):
        return None
    try:
        big = float(c.get("big_file_mb", 5)) * 1024 * 1024
    except (TypeError, ValueError):
        big = 5 * 1024 * 1024
    groups = collections.defaultdict(lambda: [0, 0, 0])  # changed, created, deleted
    for rel in set(before) | set(after):
        b, a = before.get(rel), after.get(rel)
        if not excluded_name(rel) and not (b and b[0] > big) and not (a and a[0] > big):
            continue
        if b is None:
            kind = 1
        elif a is None:
            kind = 2
        elif b != a:
            kind = 0
        else:
            continue
        parts = rel.split("/")
        key = parts[0] + "/" if len(parts) > 1 else rel
        groups[key][kind] += 1
    if not groups:
        return None
    items = sorted(groups.items(), key=lambda kv: (-sum(kv[1]), kv[0]))
    bits = []
    for key, counts in items[:5]:
        seg = [key]
        for label, i in (("changed", 0), ("created", 1), ("deleted", 2)):
            if counts[i]:
                seg.append(f"{counts[i]} {label}")
        bits.append(" ".join(seg))
    line = "--- NOTE not in diff, not undoable by reject: " + " · ".join(bits)
    if len(items) > 5:
        line += f" · +{len(items) - 5} more groups"
    return line


def pid_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def paths_overlap(a, b):
    if a is None or b is None:
        return True
    for x in a:
        for y in b:
            x, y = x.rstrip("/"), y.rstrip("/")
            if x == y or x.startswith(y + "/") or y.startswith(x + "/"):
                return True
    return False


def check_overlap(d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    for name in sorted(os.listdir(RUNNING)):
        if not name.endswith(".json"):
            continue
        p = os.path.join(RUNNING, name)
        try:
            m = json.load(open(p))
        except (OSError, ValueError):
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        if not pid_alive(m.get("pid")):
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        if os.path.realpath(m.get("dir", "")) == d and paths_overlap(m.get("paths"), paths):
            other = name[:-5]
            die(f"job {other} is already running in {d}; wait for it or use disjoint --paths")


def write_marker(jid, d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    p = os.path.join(RUNNING, jid + ".json")
    tmp = p + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({"dir": d, "paths": paths, "pid": os.getpid()}, f)
    os.replace(tmp, p)


def clear_marker(jid):
    try:
        os.remove(os.path.join(RUNNING, jid + ".json"))
    except OSError:
        pass


def claim_job(jid, d, paths):
    os.makedirs(RUNNING, exist_ok=True)
    with open(os.path.join(RUNNING, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        check_overlap(d, paths)
        write_marker(jid, d, paths)


def new_job_id():
    base = time.strftime("%m%d-%H%M%S")
    n = 0
    while True:
        jid = base if n == 0 else f"{base}-{n}"
        try:
            os.makedirs(os.path.join(JOBS, jid))
            return jid
        except FileExistsError:
            n += 1


def new_session_id():
    return "ses_ds" + secrets.token_hex(10)


def cleanup_progress():
    try:
        names = os.listdir(PROGRESS)
    except OSError:
        return
    cutoff = time.time() - 86400
    stale = time.time() - 120
    for name in names:
        p = os.path.join(PROGRESS, name)
        try:
            if os.path.getmtime(p) < cutoff:
                os.remove(p)
                continue
        except OSError:
            pass
        try:
            obj = json.load(open(p))
        except (OSError, ValueError):
            continue
        if obj.get("state") != "running":
            continue
        pid = obj.get("pid")
        dead = (not pid_alive(pid)) if pid else obj.get("updated", 0) < stale
        if dead:
            try:
                os.remove(p)
            except OSError:
                pass


def mark_interrupted(jid):
    """Rewrite a still-running progress file as error/interrupted."""
    path = os.path.join(PROGRESS, jid + ".json")
    try:
        obj = json.load(open(path))
    except (OSError, ValueError):
        return
    if obj.get("state") != "running":
        return
    started = obj.get("started") or time.time()
    obj.update({"state": "error", "last": "interrupted",
                "secs": max(0, round(time.time() - started)),
                "updated": time.time(), "pid": os.getpid()})
    try:
        tmp = path + f".tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(obj, f)
        os.replace(tmp, path)
    except OSError:
        pass


def service_auth():
    """Return (service base url, Authorization header) from service.json, or None."""
    try:
        with open(SERVICE_JSON) as f:
            svc = json.load(f)
        url = str(svc["url"]).rstrip("/")
        password = str(svc["password"])
        auth = base64.b64encode(f"opencode:{password}".encode()).decode()
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return url, "Basic " + auth


def interrupt_session(sid):
    """Ask the local OpenCode service to stop a session. True on success."""
    if not sid:
        return False
    got = service_auth()
    if not got:
        return False
    url, auth = got
    try:
        req = urllib.request.Request(
            f"{url}/api/session/{urllib.parse.quote(str(sid), safe='')}/interrupt",
            data=b"", method="POST",
            headers={"Authorization": auth, "Content-Type": "application/json"})
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(req, timeout=5) as resp:
            resp.read()
        return True
    except Exception:
        return False


def open_event_stream():
    """Open the local OpenCode SSE event stream, or return None if unavailable."""
    got = service_auth()
    if not got:
        return None
    url, auth = got
    req = urllib.request.Request(url + "/api/event", headers={
        "Accept": "text/event-stream",
        "Authorization": auth,
    })
    resp = None
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        resp = opener.open(req, timeout=3)
        # urllib's timeout also applies to reads; the connection is up now,
        # so clear it to make the consumer's readline() truly blocking.
        try:
            resp.fp.raw._sock.settimeout(None)
        except (AttributeError, OSError):
            pass
        return resp
    except Exception:
        if resp is not None:
            try:
                resp.close()
            except Exception:
                pass
        return None


def stderr_tail(path, limit=1000):
    """Read at most the last `limit` characters of a file, as one line."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - limit))
            data = f.read().decode("utf-8", "replace")
        return " ".join(data.split())
    except OSError:
        return ""


def _live_rate(segs, now_ms, cpt):
    """Live tok/s from active generation segments clipped to the last 5 s."""
    win_start = now_ms - 5000
    chars = dur_ms = 0.0
    keep = []
    for start, end, ch in segs:
        if end < win_start - 10000:
            continue
        keep.append((start, end, ch))
        if end <= win_start or start >= now_ms:
            continue
        span = end - start
        lo, hi = max(start, win_start), min(end, now_ms)
        if span <= 0 or hi <= lo:
            continue
        overlap = hi - lo
        chars += ch * overlap / span
        dur_ms += overlap
    if dur_ms >= 300 and chars:
        return int(round((chars / cpt) / (dur_ms / 1000))), keep
    return None, keep


def run_opencode(d, msg, model, agent, session=None, files=(), job=None,
                 limit_s=None, wrapup=False, deadline=None):
    c = cfg()
    limit_s = limit_s if limit_s is not None else c["timeout_s"]
    try:
        frac = float(c.get("soft_timeout_frac", 0.8))
    except (TypeError, ValueError):
        frac = 0.8
    soft_s = None if wrapup else limit_s * frac
    cmd = ["opencode", "run", "--format", "json", "--auto", "--agent", agent, "-m", model]
    if session:
        cmd += ["-s", session]
    for f in files:
        cmd += ["-f", f]
    cmd.append(msg)
    t0 = time.time()
    prev = (job or {}).get("_prog") or {}
    base_steps = int(prev.get("steps") or 0)
    base_tools = int(prev.get("tools") or 0)
    base_out = int(prev.get("out") or 0)
    inv_started = prev.get("started") or t0
    if job is not None:
        job["_prog"] = {"steps": base_steps, "tools": base_tools,
                        "out": base_out, "started": inv_started}
    sid, texts, errors = session, [], []
    tok = {"input": 0, "output": 0, "cache_read": 0}
    cost, tools, steps = 0.0, 0, 0
    last = "thinking"
    cur_msg, cur_text = None, []
    live = {"available": False, "resp": None, "segs": [],
            "cpt": 3.5, "cal_chars": 0, "cal_tokens": 0, "step_chars": 0,
            "done_out": 0,
            "last_delta_ms": None, "last_gen_ms": None, "tools": {}, "args": {},
            "step_start_ms": None, "first_gen_ms": None, "last_step_gen_ms": None,
            "dec_tokens": 0, "dec_ms": 0, "ttft": []}
    progress_lock = threading.Lock()

    def current_out():
        if live["available"]:
            # SSE-side exact count for finished steps + current-step estimate;
            # stdout step_finish events lag behind and would make this jump.
            return live["done_out"] + int(round(live["step_chars"] / live["cpt"]))
        return tok["output"]

    def sync_prog(out=None):
        if job is None:
            return
        job["_prog"] = {"steps": base_steps + steps,
                        "tools": base_tools + tools,
                        "out": base_out + (current_out() if out is None else out),
                        "started": inv_started}

    def tok_s():
        return (round(live["dec_tokens"] / (live["dec_ms"] / 1000))
                if live["dec_ms"] else None)

    def ttft_s():
        med = _median(live["ttft"])
        return round(med / 1000, 1) if med is not None else None

    def live_view(now_ms):
        """Return live tok/s plus phase and its timing fields."""
        if not live["available"]:
            return None, None, None, None, None
        live_tok, live["segs"] = _live_rate(live["segs"], now_ms, live["cpt"])
        tool_since = args_since = args_tool = None
        if live["args"]:
            phase = "args"
            args_since = int(min(v[0] for v in live["args"].values()) // 1000)
            args_tool = max(live["args"].values(), key=lambda v: v[0])[1]
        elif live["tools"]:
            phase = "tool"
            tool_since = int(min(v[0] for v in live["tools"].values()) // 1000)
        elif (live["last_delta_ms"] is not None
              and now_ms - live["last_delta_ms"] <= 2000):
            phase = "writing"
        else:
            phase = "waiting"
        return live_tok, phase, tool_since, args_tool, args_since

    def write_progress(state, totals=None, **extra):
        with progress_lock:
            now_ms = int(time.time() * 1000)
            live_tok, phase, tool_since, args_tool, args_since = live_view(now_ms)
            last_shown = (max(live["tools"].values(), key=lambda v: v[0])[1]
                          if live["available"] and live["tools"] else last)
            if totals is None:
                totals = {"steps": base_steps + steps,
                          "tools": base_tools + tools,
                          "out": base_out + current_out(),
                          "started": inv_started}
            obj = {"state": state, "job": job["id"], "round": job["round"],
                   "model": model, "dir": os.path.basename(d),
                   "started": totals.get("started", inv_started),
                   "updated": time.time(), "steps": totals["steps"],
                   "tools": totals["tools"],
                   "last": last_shown, "pid": os.getpid(),
                   "out_tokens": totals["out"],
                   "tok_s": tok_s(), "ttft_s": ttft_s(), "live_tok_s": live_tok,
                   "phase": phase, "tool_since": tool_since, "args_tool": args_tool,
                   "args_since": args_since}
            obj.update(extra)
            try:
                os.makedirs(PROGRESS, exist_ok=True)
                path = os.path.join(PROGRESS, job["id"] + ".json")
                tmp = path + f".tmp.{os.getpid()}"
                with open(tmp, "w") as f:
                    json.dump(obj, f)
                os.replace(tmp, path)
            except OSError:
                pass

    env = dict(os.environ, PWD=d)
    # opencode follows $PWD, not the process cwd
    stderr_file = tempfile.NamedTemporaryFile(prefix="ds-opencode-", suffix=".log",
                                              delete=False)
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=stderr_file,
                         stdin=subprocess.DEVNULL, text=True, cwd=d, env=env,
                         start_new_session=True)
    q = queue.Queue()

    def _reader():
        try:
            for line in p.stdout:
                q.put(line)
        finally:
            q.put(None)

    threading.Thread(target=_reader, daemon=True).start()

    stop_live = threading.Event()

    def _live_reader():
        nonlocal last
        resp = open_event_stream()
        if resp is None:
            return
        if stop_live.is_set():
            try:
                resp.close()
            except Exception:
                pass
            return
        with progress_lock:
            live["resp"] = resp
            live["available"] = True
        last_write = 0.0
        try:
            while not stop_live.is_set():
                try:
                    line = resp.readline()
                except Exception:
                    break
                if not line or stop_live.is_set():
                    break
                s = sid
                # Cheap pre-filter: most events belong to other sessions.
                if not s or s.encode() not in line:
                    continue
                try:
                    text = line.decode("utf-8", "replace")
                except Exception:
                    continue
                if not text.startswith("data:"):
                    continue
                try:
                    ev = json.loads(text[5:].strip())
                except ValueError:
                    continue
                data = ev.get("data") or {}
                if data.get("sessionID") != s:
                    continue
                now_ms = int(time.time() * 1000)
                created = ev.get("created")
                try:
                    created = int(created) if created is not None else now_ms
                except (TypeError, ValueError):
                    created = now_ms
                ty = ev.get("type")
                with progress_lock:
                    if ty in ("session.reasoning.delta", "session.text.delta"):
                        n = len(data.get("delta") or "")
                        if n:
                            prev = live["last_gen_ms"]
                            if prev is not None and created - prev <= 1000:
                                live["segs"].append((prev, created, n))
                            else:
                                # New burst: no active time for its first delta.
                                live["segs"].append((created, created, 0))
                            live["last_delta_ms"] = created
                            live["step_chars"] += n
                        live["last_gen_ms"] = created
                        if live["first_gen_ms"] is None:
                            live["first_gen_ms"] = created
                        live["last_step_gen_ms"] = created
                    elif ty == "session.step.started":
                        live["step_chars"] = 0
                        started = data.get("started")
                        try:
                            live["step_start_ms"] = (int(started)
                                                     if started is not None else created)
                        except (TypeError, ValueError):
                            live["step_start_ms"] = created
                        live["first_gen_ms"] = None
                        live["last_step_gen_ms"] = None
                    elif ty == "session.step.ended":
                        tk = data.get("tokens")
                        if not isinstance(tk, dict):
                            tk = {}
                        out_tok = int(tk.get("output") or 0) + int(tk.get("reasoning") or 0)
                        first_gen = live["first_gen_ms"]
                        last_gen = live["last_step_gen_ms"]
                        step_start = live["step_start_ms"]
                        if (out_tok > 0 and first_gen is not None
                                and last_gen is not None and step_start is not None):
                            span = last_gen - first_gen
                            if span >= 100:
                                live["dec_tokens"] += out_tok
                                live["dec_ms"] += span
                                live["ttft"].append(max(0, first_gen - step_start))
                        live["cal_chars"] += live["step_chars"]
                        live["cal_tokens"] += out_tok
                        live["done_out"] += out_tok
                        live["step_chars"] = 0
                        if live["cal_tokens"] > 0:
                            cpt = live["cal_chars"] / live["cal_tokens"]
                            live["cpt"] = min(8.0, max(1.5, cpt))
                        live["step_start_ms"] = None
                        live["first_gen_ms"] = None
                        live["last_step_gen_ms"] = None
                        live["tools"].clear()
                        live["args"].clear()
                    elif ty == "session.tool.input.started":
                        live["last_gen_ms"] = created
                        if live["first_gen_ms"] is None:
                            live["first_gen_ms"] = created
                        live["last_step_gen_ms"] = created
                        cid = data.get("id")
                        nm = data.get("name") or data.get("tool") or "tool"
                        if cid is not None:
                            live["args"][cid] = (created, nm)
                    elif ty == "session.tool.input.ended":
                        live["last_gen_ms"] = created
                        if live["first_gen_ms"] is None:
                            live["first_gen_ms"] = created
                        live["last_step_gen_ms"] = created
                        cid = data.get("id")
                        pending = live["args"].pop(cid, None) if cid is not None else None
                        if pending is not None:
                            start_ms = pending[0]
                            text = data.get("text")
                            if not isinstance(text, str):
                                text = "" if text is None else str(text)
                            n = len(text)
                            live["step_chars"] += n
                            if n:
                                live["segs"].append(
                                    (start_ms, max(start_ms, created), n))
                    elif ty == "session.tool.called":
                        inp = data.get("input")
                        if not isinstance(inp, dict):
                            inp = {}
                        nm = data.get("tool") or data.get("name") or "tool"
                        detail = (inp.get("command") or inp.get("path")
                                  or inp.get("filePath") or inp.get("pattern") or "")
                        if not isinstance(detail, str):
                            detail = str(detail)
                        label = " ".join(f"{nm} {detail}".split())[:60] or "tool"
                        cid = data.get("id") or f"call-{created}"
                        live["tools"][cid] = (created, label)
                        last = label
                    elif ty in ("session.tool.success", "session.tool.error",
                                "session.tool.failed"):
                        cid = data.get("id")
                        if cid is not None:
                            live["tools"].pop(cid, None)
                if stop_live.is_set():
                    break
                now = time.time()
                if now - last_write >= 1:
                    write_progress("running")
                    last_write = now
        finally:
            with progress_lock:
                live["available"] = False
                live["resp"] = None
            try:
                resp.close()
            except Exception:
                pass

    live_thread = threading.Thread(target=_live_reader, daemon=True)
    live_thread.start()
    timed_out, soft_hit = False, False
    stopped_by_ds = False
    stderr_text = ""
    n_events = 0
    last_tick = 0.0
    try:
        while True:
            elapsed = time.time() - t0
            if elapsed > limit_s:
                timed_out = True
                break
            if soft_s is not None and soft_s < limit_s and elapsed > soft_s:
                soft_hit = True
                break
            try:
                line = q.get(timeout=0.5)
            except queue.Empty:
                now = time.time()
                if now - last_tick >= 1:
                    write_progress("running")
                    last_tick = now
                continue
            if line is None:
                break
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            n_events += 1
            sid = ev.get("sessionID", sid)
            t, part = ev.get("type"), ev.get("part") or {}
            if t == "step_start":
                steps += 1
                if tools == 0:
                    last = "thinking"
            if t == "text":
                if part.get("messageID") != cur_msg:
                    cur_msg, cur_text = part.get("messageID"), []
                    texts.append(cur_text)
                cur_text.append(part.get("text", ""))
            elif t in ("tool_use", "tool"):
                tools += 1
                nm = part.get("tool") or "tool"
                inp = (part.get("state") or {}).get("input") or {}
                if nm == "shell":
                    detail = inp.get("command") or ""
                else:
                    detail = inp.get("path") or inp.get("filePath") or inp.get("pattern") or ""
                last = " ".join(f"{nm} {detail}".split())[:60]
            elif t == "step_finish":
                tk = part.get("tokens") or {}
                tok["input"] += tk.get("input", 0)
                tok["output"] += tk.get("output", 0) + tk.get("reasoning", 0)
                tok["cache_read"] += (tk.get("cache") or {}).get("read", 0)
                cost += part.get("cost") or 0
            elif t == "error":
                errors.append((ev.get("error") or {}).get("message", "unknown error"))
            write_progress("running")
        if not timed_out and not soft_hit:
            p.wait()
    finally:
        if p.poll() is None:
            stopped_by_ds = True
            if sid:
                try:
                    interrupt_session(sid)
                except Exception:
                    pass
                try:
                    p.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    pass
            if p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except OSError:
                    pass
                try:
                    p.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(p.pid, signal.SIGKILL)
                    except OSError:
                        pass
                    try:
                        p.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        pass
        stop_live.set()
        with progress_lock:
            resp = live["resp"]
        if resp is not None:
            try:
                resp.close()
            except Exception:
                pass
        live_thread.join(timeout=2)
        with progress_lock:
            live["available"] = False
        try:
            stderr_file.close()
        except Exception:
            pass
        stderr_text = stderr_tail(stderr_file.name)
        try:
            os.remove(stderr_file.name)
        except OSError:
            pass
    if timed_out:
        errors.append(f"timeout after {int(limit_s)}s")
    if (not timed_out and not soft_hit and not stopped_by_ds
            and p.returncode not in (None, 0)):
        reason = stderr_text[:300] if stderr_text else "no stderr"
        errors.append(f"opencode exited {p.returncode}: {reason}")
    if n_events == 0 and not errors:
        errors.append("no output from opencode: " + (stderr_text[:300] or "empty stderr"))
    final = "".join(texts[-1]).strip() if texts else ""
    secs = round(time.time() - t0)
    write_progress("error" if errors else "done", updated=time.time(), secs=secs)
    sync_prog()
    res = {"session": sid, "report": final, "errors": errors, "tokens": tok,
           "cost": cost, "tools": tools, "secs": secs, "tok_s": tok_s(),
           "dec_tokens": live["dec_tokens"], "dec_ms": live["dec_ms"],
           "ttft": list(live["ttft"])}
    if soft_hit:
        if sid:
            wrap_limit = c["wrapup_s"]
            if deadline is not None:
                wrap_limit = min(wrap_limit, max(60, deadline - time.time()))
            w = run_opencode(d, WRAPUP_MSG, model, agent, session=sid, job=job,
                             limit_s=wrap_limit, wrapup=True, deadline=deadline)
            res["soft_deadline"] = {"at": secs, "limit_s": int(limit_s), "frac": frac}
            res["report"] = w["report"] or final
            for k in ("input", "output", "cache_read"):
                res["tokens"][k] += w["tokens"].get(k, 0)
            res["cost"] += w.get("cost", 0) or 0
            res["secs"] += w.get("secs", 0) or 0
            res["tools"] += w.get("tools", 0) or 0
            res["dec_tokens"] += w.get("dec_tokens") or 0
            res["dec_ms"] += w.get("dec_ms") or 0
            res["ttft"] += w.get("ttft") or []
            res["tok_s"] = (round(res["dec_tokens"] / (res["dec_ms"] / 1000))
                            if res["dec_ms"] else None)
            live["dec_tokens"] = res["dec_tokens"]
            live["dec_ms"] = res["dec_ms"]
            live["ttft"] = list(res["ttft"])
            res["errors"] += w["errors"]
            res["session"] = w.get("session") or sid
            write_progress("error" if res["errors"] else "done",
                           totals=job.get("_prog") if job is not None else None,
                           updated=time.time(), secs=res["secs"])
        else:
            res["errors"].append(f"soft deadline after {int(secs)}s (no session to wrap up)")
    return res


def write_progress_file(job, model, **fields):
    path = os.path.join(PROGRESS, job["id"] + ".json")
    try:
        obj = json.load(open(path))
    except (OSError, ValueError):
        obj = {"state": "running", "started": time.time(), "steps": 0, "tools": 0,
               "out_tokens": 0, "tok_s": None, "ttft_s": None,
               "job": job["id"], "round": job["round"],
               "model": model, "dir": os.path.basename(job["dir"])}
    obj.update(fields)
    obj["pid"] = os.getpid()
    obj["updated"] = time.time()
    try:
        os.makedirs(PROGRESS, exist_ok=True)
        tmp = path + f".tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(obj, f)
        os.replace(tmp, path)
    except OSError:
        pass


def write_check_progress(job, model, cmd):
    write_progress_file(job, model, state="running", last="check: " + cmd[:40],
                        phase="tool", tool_since=int(time.time()), live_tok_s=None,
                        args_tool=None, args_since=None)


def run_check(d, cmd, timeout_s):
    """Run cmd with bash -c in d; return pass flag, exit code and last 60 lines."""
    env = dict(os.environ, PWD=d)
    try:
        r = subprocess.run(["bash", "-c", cmd], cwd=d, env=env, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True, timeout=timeout_s)
        out, code = r.stdout or "", r.returncode
    except subprocess.TimeoutExpired as e:
        out = e.stdout or ""
        if isinstance(out, bytes):
            out = out.decode(errors="replace")
        out += f"\n[check timed out after {timeout_s}s]"
        code = 124
    lines = out.splitlines()
    return {"pass": code == 0, "code": code, "output": "\n".join(lines[-60:])}


def run_with_check(job, msg, session=None, files=(), budget_s=None):
    """Run the worker, then keep auto-fixing until the job's check passes."""
    d = job["dir"]
    c = cfg()
    try:
        budget_s = float(budget_s if budget_s is not None else c["job_budget_s"])
    except (TypeError, ValueError):
        budget_s = 1800.0
    deadline = time.time() + max(0.0, budget_s)

    def remaining():
        return deadline - time.time()

    def limit(cap):
        return min(cap, max(1.0, remaining()))

    res = run_opencode(d, msg, job["model"], job["agent"], session=session, files=files,
                       job=job, limit_s=limit(c["timeout_s"]), deadline=deadline)
    if res["errors"]:
        return res
    check = job.get("check")
    if not check:
        return res
    tries = max(0, int(job.get("fix_tries") or 0))
    timeout_s = c["check_timeout_s"]
    results, rounds, skipped = [res], 0, 0
    while True:
        write_check_progress(job, job["model"], check)
        chk = run_check(d, check, limit(timeout_s))
        if chk["pass"] or rounds >= tries:
            break
        if remaining() < FIX_MIN_S:
            skipped = tries - rounds
            break
        rounds += 1
        fmsg = (f"AUTOMATED CHECK FAILED (not the reviewer). Command: {check}\n"
                f"Exit: {chk['code']}\nLast output lines:\n{chk['output']}\n"
                "Fix the cause within the original task scope, then reply with the "
                "final report block.")
        res = run_opencode(d, fmsg, job["model"], job["agent"],
                           session=res.get("session") or job.get("session"), job=job,
                           limit_s=limit(c["timeout_s"]), deadline=deadline)
        results.append(res)
        if res["errors"]:
            return res
    last = results[-1]
    tok = {k: sum(r["tokens"].get(k, 0) for r in results)
           for k in ("input", "output", "cache_read")}
    out = dict(last)
    out["tokens"] = tok
    out["cost"] = sum(r.get("cost", 0) or 0 for r in results)
    out["secs"] = sum(r.get("secs", 0) or 0 for r in results)
    out["dec_tokens"] = sum(r.get("dec_tokens") or 0 for r in results)
    out["dec_ms"] = sum(r.get("dec_ms") or 0 for r in results)
    out["ttft"] = [x for r in results for x in (r.get("ttft") or [])]
    out["tok_s"] = (round(out["dec_tokens"] / (out["dec_ms"] / 1000))
                    if out["dec_ms"] else None)
    soft = [r["soft_deadline"] for r in results if r.get("soft_deadline")]
    if soft:
        out["soft_deadline"] = soft[0]
    out["check"] = {"cmd": check, "pass": chk["pass"], "code": chk["code"],
                    "output": chk["output"], "rounds": rounds}
    if skipped:
        out["check"]["budget_skipped"] = skipped
    ttft_med = _median(out["ttft"])
    write_progress_file(job, job["model"], state="error" if last["errors"] else "done",
                        last="check: " + ("pass" if chk["pass"] else "fail"),
                        secs=out["secs"], out_tokens=tok["output"], tok_s=out["tok_s"],
                        ttft_s=(round(ttft_med / 1000, 1) if ttft_med is not None else None))
    return out


def diff_text(job, full=False, paths=(), since=None):
    d, gd = job["dir"], job["shadow"]
    idx = job_index(job["id"])
    job_paths = job.get("paths")
    stage_paths(gd, d, job_paths, idx)
    scope = list(paths) if paths else (job_paths or [])
    since = since or job["base"]
    stat = git(gd, d, "diff", "--cached", "--stat=100", since, "--", *scope, index=idx)
    body = git(gd, d, "diff", "--cached", "-U2", "--no-color", since, "--", *scope, index=idx)
    lines = body.splitlines()
    jdir = os.path.join(JOBS, job["id"])
    open(os.path.join(jdir, "full.diff"), "w").write(body)
    cap = cfg()["max_diff_lines"]
    if not full and len(lines) > cap:
        body = "\n".join(lines[:cap]) + (
            f"\n... [diff truncated: {len(lines) - cap} more lines. "
            f"`ds diff {job['id']} --full` or `ds diff {job['id']} <path>`; "
            f"file: {jdir}/full.diff]")
    return stat.strip(), body


def save(job):
    p = os.path.join(JOBS, job["id"], "job.json")
    tmp = p + f".tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump({k: v for k, v in job.items() if not k.startswith("_")},
                  f, indent=1)
    os.replace(tmp, p)


def load(jid):
    p = os.path.join(JOBS, jid, "job.json")
    if not os.path.exists(p):
        die(f"no job {jid}")
    return json.load(open(p))


def _median(vals):
    vals = sorted(vals)
    if not vals:
        return None
    n = len(vals)
    return vals[n // 2] if n % 2 else (vals[n // 2 - 1] + vals[n // 2]) / 2


def fmt_num(n):
    """Format a token count as 1.2M / 340k / 912."""
    n = int(round(n))
    sign = "-" if n < 0 else ""
    a = abs(n)
    if a >= 1_000_000:
        return f"{sign}{a / 1_000_000:.1f}M" if a < 10_000_000 else f"{sign}{a / 1_000_000:.0f}M"
    if a >= 1_000:
        return f"{sign}{a / 1_000:.1f}k" if a < 10_000 else f"{sign}{a / 1_000:.0f}k"
    return f"{sign}{a}"


def saved_tokens(worker_in, worker_cache, worker_out, claude_chars):
    return worker_in + 0.1 * worker_cache + worker_out - claude_chars / 4


def _entry_saved(e):
    return saved_tokens(int(e.get("worker_in") or 0),
                        int(e.get("worker_cache") or 0),
                        int(e.get("worker_out") or 0),
                        int(e.get("claude_chars") or 0))


def refresh_today():
    """Recompute today.json from the ledger (old formula values get corrected)."""
    today = time.strftime("%Y-%m-%d")
    saved = 0
    job_ids = set()
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                ts = e.get("ts") or 0
                try:
                    day = time.strftime("%Y-%m-%d", time.localtime(ts))
                except (OSError, ValueError, OverflowError):
                    continue
                if day != today:
                    continue
                saved += int(round(_entry_saved(e)))
                if e.get("job"):
                    job_ids.add(e["job"])
    except OSError:
        pass
    try:
        tmp = TODAY + f".tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump({"date": today, "saved_tokens": saved,
                       "jobs": len(job_ids)}, f)
        os.replace(tmp, TODAY)
    except OSError:
        pass


def record_ledger(job, res, claude_chars):
    tk = res["tokens"]
    ttft_med = _median(res.get("ttft") or [])
    entry = {"ts": int(time.time()), "job": job["id"], "round": job["round"],
             "dir": job["dir"], "worker_in": tk["input"],
             "worker_cache": tk["cache_read"], "worker_out": tk["output"],
             "claude_chars": claude_chars, "secs": res.get("secs"),
             "tok_s": res.get("tok_s"),
             "ttft_ms": (int(round(ttft_med)) if ttft_med is not None else None),
             "check": (None if not res.get("check")
                       else "pass" if res["check"]["pass"] else "fail")}
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, ".ledger.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with open(LEDGER, "a") as f:
                f.write(json.dumps(entry, separators=(",", ":")) + "\n")
            refresh_today()
    except Exception:
        pass


def emit(job, res):
    c = cfg()
    rep = res["report"] or "(worker gave no final report)"
    if len(rep) > c["max_report_chars"]:
        rep = rep[:c["max_report_chars"]] + " …[report truncated]"
    rb = job.get("round_base")
    stat, body = diff_text(job, since=rb)
    tk = res["tokens"]
    out = [f"JOB {job['id']}  round {job['round']}  dir {job['dir']}"]
    line = (f"worker: {job['model']}  {res['secs']}s  tok in {tk['input']} "
            f"(cache {tk['cache_read']}) out {tk['output']}  cost ${res['cost']:.4f}")
    if res.get("tok_s") is not None:
        line += f"  gen {res['tok_s']} tok/s"
    ttft_med = _median(res.get("ttft") or [])
    if ttft_med is not None:
        line += f" · first token {ttft_med / 1000:.1f}s"
    out.append(line)
    soft = res.get("soft_deadline")
    if soft:
        out.append(f"SOFT DEADLINE HIT: worker stopped at {soft['at']}s "
                   f"({soft['frac']:g} × {soft['limit_s']}s) and was asked to wrap up.")
    if res["errors"]:
        out.append("ERRORS: " + " | ".join(e[:300] for e in res["errors"]))
    out.append("--- report")
    out.append(rep)
    chk = res.get("check")
    if chk:
        out.append("--- check")
        if chk["pass"]:
            extra = f" (after {chk['rounds']} auto-fix rounds)" if chk["rounds"] > 0 else ""
            out.append(f"PASS  {chk['cmd']}{extra}")
        else:
            out.append(f"FAIL  {chk['cmd']}  exit {chk['code']}  "
                       f"after {chk['rounds']} auto-fix rounds")
            if chk["output"]:
                out.append("\n".join(chk["output"].splitlines()[-30:]))
        if chk.get("budget_skipped"):
            out.append(f"budget exhausted, {chk['budget_skipped']} fix rounds skipped")
    if res.get("outside"):
        out.append("--- WARNING: changes outside --paths")
        out.extend(res["outside"])
    if res.get("excluded_note"):
        out.append(res["excluded_note"])
    if rb:
        out.append(f"--- this round only (cumulative: ds diff {job['id']})")
    out.append("--- diff stat")
    out.append(stat.rstrip() or "(no changes)")
    if body:
        out.append("--- diff")
        out.append(body)
    out.append(f"--- next: ds approve {job['id']} | ds revise {job['id']} \"...\" | ds reject {job['id']}")
    text = "\n".join(out) + "\n"
    sys.stdout.write(text)
    record_ledger(job, res, len(text))


def notify_cmd(job, res):
    """Return the notify-send argv for a finished job, or None to stay quiet."""
    c = cfg()
    if not c.get("notify", True):
        return None
    try:
        min_s = int(c.get("notify_min_s", 15))
    except (TypeError, ValueError):
        min_s = 15
    secs = int(res.get("secs") or 0)
    if secs < min_s or not shutil.which("notify-send"):
        return None
    base = os.path.basename(job["dir"].rstrip("/")) or job["dir"]
    when = f"{secs // 60}:{secs % 60:02d}"
    errs = res.get("errors") or []
    if errs:
        title = f"DeepSeek {job['id']} failed"
        body = f"{base} · {when} · {str(errs[0])[:100]}"
    else:
        title = f"DeepSeek {job['id']} done"
        body = f"{base} · {when}"
        chk = res.get("check")
        if chk:
            body += " · check " + ("PASS" if chk["pass"] else "FAIL")
    return ["notify-send", "-a", "ds-bridge", title, body]


def notify_done(job, res):
    try:
        cmd = notify_cmd(job, res)
        if cmd:
            subprocess.run(cmd, timeout=5, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    except Exception:
        pass


def cmd_stats(a):
    now = time.time()
    if a.all:
        cutoff = None
    elif a.days is not None:
        cutoff = now - int(a.days) * 86400
    else:
        lt = time.localtime()
        cutoff = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1))
    rows = []
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if cutoff is None or e.get("ts", 0) >= cutoff:
                    rows.append(e)
    except OSError:
        pass
    win = sum(int(e.get("worker_in") or 0) for e in rows)
    wca = sum(int(e.get("worker_cache") or 0) for e in rows)
    wout = sum(int(e.get("worker_out") or 0) for e in rows)
    chars = sum(int(e.get("claude_chars") or 0) for e in rows)
    claude_tok = chars / 4
    saved = saved_tokens(win, wca, wout, chars)
    jobs = len({e.get("job") for e in rows if e.get("job")})
    print(f"jobs {jobs} · rounds {len(rows)}")
    print(f"worker tokens: in {fmt_num(win)} / cache {fmt_num(wca)} / out {fmt_num(wout)}")
    print(f"Claude read: {fmt_num(chars)} chars ≈ {fmt_num(claude_tok)} tokens")
    print(f"est. saved: ≈ {fmt_num(saved)} tokens")
    speed_rows = [e for e in rows
                  if e.get("tok_s") is not None or e.get("ttft_ms") is not None]
    if speed_rows:
        speeds = [e["tok_s"] for e in speed_rows if e.get("tok_s") is not None]
        ttfts = [e["ttft_ms"] for e in speed_rows if e.get("ttft_ms") is not None]
        parts = []
        if speeds:
            parts.append(f"median {int(round(_median(speeds)))} tok/s decode")
        if ttfts:
            parts.append(f"median {_median(ttfts) / 1000:.1f}s first token")
        print(f"speed: {' · '.join(parts)} ({len(speed_rows)} rounds)")
    print("estimate: input-equivalent tokens Claude would have spent doing it itself (cache reads weighted 0.1×), minus what it read from ds")


def _tool_short(part):
    nm = part.get("name") or part.get("tool") or "tool"
    inp = (part.get("state") or {}).get("input") or {}
    detail = (inp.get("command") or inp.get("path") or inp.get("filePath")
              or inp.get("pattern") or "")
    detail = " ".join(str(detail).split())
    if len(detail) > 100:
        detail = detail[:100] + "…"
    return f"  ▸ {nm} {detail}".rstrip()


def _tool_output(part):
    st = part.get("state") or {}
    if isinstance(st.get("output"), str):
        out = st["output"]
    else:
        out = "\n".join(c.get("text", "") for c in (st.get("content") or [])
                        if isinstance(c, dict) and c.get("type") == "text")
    return out.splitlines()[:6]


def cmd_log(a):
    job = load(a.job)
    sid = job.get("session")
    if not sid:
        die(f"job {a.job} has no session to export")
    # opencode truncates a piped export at 320 KiB; a file redirect is complete.
    fd, tmp = tempfile.mkstemp(prefix="ds-export-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            r = subprocess.run(["opencode", "session", "export", sid],
                               stdout=out, stderr=subprocess.PIPE, text=True)
        if r.returncode:
            msg = (r.stderr or "").strip()
            if not msg:
                try:
                    with open(tmp, encoding="utf-8") as f:
                        msg = f.read().strip()[:500]
                except OSError:
                    pass
            print(msg or "session export failed", file=sys.stderr)
            sys.exit(1)
        try:
            with open(tmp, encoding="utf-8") as f:
                data = json.load(f)
        except ValueError as e:
            print(f"ds: could not parse session export: {e}", file=sys.stderr)
            sys.exit(1)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass
    for m in data.get("messages") or []:
        t = m.get("type")
        if t == "user":
            if a.tools_only:
                continue
            print("── user")
            print((m.get("text") or "")[:400])
        elif t == "assistant":
            blocks = []
            for part in m.get("content") or []:
                if part.get("type") == "text" and not a.tools_only:
                    blocks.append(("text", part.get("text") or ""))
                elif part.get("type") == "tool":
                    blocks.append(("tool", part))
            if not blocks:
                continue
            print("── worker")
            for kind, val in blocks:
                if kind == "text":
                    print(val)
                else:
                    print(_tool_short(val))
                    for ln in _tool_output(val):
                        print("    " + ln)


def cmd_init(a):
    d = os.path.realpath(a.C or os.getcwd())
    target = os.path.join(d, "AGENTS.md")
    exists = os.path.exists(target)
    if exists and not a.refresh:
        die("AGENTS.md exists; use --refresh to rewrite it")
    task = INIT_REFRESH if a.refresh else INIT_BASE
    ns = argparse.Namespace(C=d, m=None, paths=["AGENTS.md"], check=None,
                            fix_tries=None, f=None, task=task, timeout=a.timeout)
    cmd_run(ns)


def cmd_run(a):
    c = cfg()
    d = os.path.realpath(a.C or os.getcwd())
    if d in (HOME, "/"):
        die("refusing to run in $HOME or / ; pass -C <project dir>")
    task = a.task if a.task != "-" else sys.stdin.read()
    paths = norm_paths(a.paths)
    budget = a.timeout if a.timeout is not None else c["job_budget_s"]
    os.makedirs(JOBS, exist_ok=True)
    jid = new_job_id()
    gd = shadow_for(d)
    try:
        claim_job(jid, d, paths)
    except SystemExit:
        try:
            os.rmdir(os.path.join(JOBS, jid))
        except OSError:
            pass
        raise
    job = None
    post_taken = False
    try:
        base = snapshot(d, gd, f"pre {jid}", job_index(jid), jid, paths)
        job = {"id": jid, "dir": d, "shadow": gd, "base": base, "model": a.m or c["model"],
               "agent": c["agent"], "session": new_session_id(), "round": 1, "status": "open",
               "paths": paths, "task": task, "check": a.check,
               "fix_tries": a.fix_tries if a.fix_tries is not None else c["fix_tries"]}
        save(job)
        outside = outside_listing(d, paths) if paths else None
        want_note = c.get("excluded_note", True)
        excluded = excluded_listing(d, paths) if want_note else None
        res = run_with_check(job, task, session=job["session"], files=a.f or (),
                             budget_s=budget)
        if outside is not None:
            res["outside"] = outside_changes(outside, outside_listing(d, paths))
        if excluded is not None:
            note = excluded_note(excluded, excluded_listing(d, paths), c)
            if note:
                res["excluded_note"] = note
        job["post"] = snapshot(d, gd, f"post r{job['round']}", job_index(jid), jid, paths)
        post_taken = True
        if res.get("session"):
            job["session"] = res["session"]
        save(job)
        emit(job, res)
        notify_done(job, res)
    finally:
        if job is not None and not post_taken:
            try:
                job["post"] = snapshot(d, gd, f"post r{job['round']}",
                                       job_index(jid), jid, paths)
                save(job)
            except BaseException:
                pass
        mark_interrupted(jid)
        clear_marker(jid)
        cleanup_progress()


def cmd_revise(a):
    job = load(a.job)
    if job["status"] != "open":
        die(f"job {a.job} is {job['status']}")
    c = cfg()
    budget = a.timeout if a.timeout is not None else c["job_budget_s"]
    paths = job.get("paths")
    claim_job(job["id"], job["dir"], paths)
    post_taken = False
    try:
        job["round"] += 1
        job["round_base"] = snapshot(job["dir"], job["shadow"], f"{job['id']} r{job['round']}",
                                     job_index(job["id"]), job["id"], paths)
        if a.check is not None:
            job["check"] = a.check
        msg = ("REVIEW FEEDBACK - revise your work. Fix exactly these points, nothing else, "
               "then reply with the same final report block (describe only this round's changes):\n"
               + (a.feedback if a.feedback != "-" else sys.stdin.read()))
        if not job.get("session"):
            msg = "ORIGINAL TASK:\n" + (job.get("task") or "") + "\n\n" + msg
            job["session"] = new_session_id()
            save(job)
        outside = outside_listing(job["dir"], paths) if paths else None
        want_note = c.get("excluded_note", True)
        excluded = excluded_listing(job["dir"], paths) if want_note else None
        res = run_with_check(job, msg, session=job["session"], budget_s=budget)
        if outside is not None:
            res["outside"] = outside_changes(outside, outside_listing(job["dir"], paths))
        if excluded is not None:
            note = excluded_note(excluded, excluded_listing(job["dir"], paths), c)
            if note:
                res["excluded_note"] = note
        job["post"] = snapshot(job["dir"], job["shadow"], f"post r{job['round']}",
                               job_index(job["id"]), job["id"], paths)
        post_taken = True
        save(job)
        emit(job, res)
        notify_done(job, res)
    finally:
        if not post_taken:
            try:
                job["post"] = snapshot(job["dir"], job["shadow"], f"post r{job['round']}",
                                       job_index(job["id"]), job["id"], paths)
                save(job)
            except BaseException:
                pass
        mark_interrupted(job["id"])
        clear_marker(job["id"])
        cleanup_progress()


def cmd_diff(a):
    job = load(a.job)
    if job["status"] != "open":
        die(f"job {a.job} is {job['status']}; snapshot removed, nothing to diff")
    stat, body = diff_text(job, full=a.full, paths=a.paths)
    print(stat.rstrip() or "(no changes)")
    print(body)


def cmd_approve(a):
    job = load(a.job)
    if job["status"] != "open":
        die(f"job {a.job} is {job['status']}; nothing to approve")
    job["status"] = "approved"
    save(job)
    cleanup_shadow(job)
    print(f"approved {a.job}")


def commit_blob(gd, wt, commit, path):
    """Blob hash of path in commit, or "absent"."""
    out = git(gd, wt, "ls-tree", "-z", commit, "--", path).strip("\0\n")
    if not out:
        return "absent"
    parts = out.split("\t", 1)[0].split()
    if len(parts) >= 3 and parts[1] in ("blob", "commit"):
        return parts[2]
    return "absent"


def worktree_blob(gd, wt, path):
    """Blob hash of the current working file, or "absent"/"unreadable"."""
    if not os.path.lexists(os.path.join(wt, path)):
        return "absent"
    try:
        r = subprocess.run(["git", "-c", "core.quotePath=false",
                            f"--git-dir={gd}", f"--work-tree={wt}",
                            "hash-object", "--", path],
                           capture_output=True, text=True, cwd=wt)
    except OSError:
        return "unreadable"
    if r.returncode:
        return "unreadable"
    return r.stdout.strip()


def prune_empty_dirs(root, rel):
    """Remove parent dirs of rel left empty, never reaching root itself."""
    root = os.path.realpath(root)
    parent = os.path.dirname(rel.replace(os.sep, "/"))
    while parent and parent not in (".", ""):
        path = os.path.realpath(os.path.join(root, parent))
        if path == root or not path.startswith(root + os.sep):
            break
        try:
            os.rmdir(path)
        except OSError:
            break
        parent = os.path.dirname(parent)


def cmd_reject(a):
    job = load(a.job)
    if job["status"] != "open":
        die(f"job {a.job} is {job['status']}; nothing to reject")
    d, gd = job["dir"], job["shadow"]
    idx = job_index(job["id"])
    paths = job.get("paths")
    if not job.get("post"):
        print(f"ds: warning: job {a.job} has no post-run snapshot; "
              "restoring the whole scope to the pre-job state")
        stage_paths(gd, d, paths, idx)
        # files created since snapshot -> remove; changed/deleted -> restore
        diff_args = ["diff", "--cached", "--name-only", "-z",
                     "--diff-filter=A", job["base"]]
        if paths:
            diff_args += ["--", *paths]
        added = [f for f in git(gd, d, *diff_args, index=idx).split("\0") if f]
        for f in added:
            try:
                os.remove(os.path.join(d, f))
            except OSError:
                pass
        if paths:
            # New paths are absent from base; check out only paths that base has.
            base_paths = [f for f in git(gd, d, "ls-tree", "-r", "-z", "--name-only",
                                        job["base"], "--", *paths, index=idx).split("\0") if f]
            if base_paths:
                git(gd, d, "checkout", job["base"], "--", *base_paths, index=idx)
        else:
            git(gd, d, "checkout", job["base"], "--", ".", index=idx)
        job["status"] = "rejected"
        save(job)
        cleanup_shadow(job)
        print(f"rejected {a.job}: restored {d} to pre-job state ({len(added)} new files removed)")
        return

    post = job["post"]
    diff_args = ["diff", "--name-status", "-z", "--no-renames", job["base"], post]
    if paths:
        diff_args += ["--", *paths]
    entries = [e for e in git(gd, d, *diff_args).split("\0") if e]
    files = [entries[i + 1] for i in range(0, len(entries) - 1, 2)
             if entries[i + 1]]

    restore, skipped = [], []
    for f in files:
        if worktree_blob(gd, d, f) == commit_blob(gd, d, post, f):
            restore.append(f)
        else:
            skipped.append(f)
    force = bool(getattr(a, "force", False))
    if force:
        restore += skipped
        skipped = []

    restored, removed = 0, []
    for f in restore:
        if commit_blob(gd, d, job["base"], f) == "absent":
            try:
                os.remove(os.path.join(d, f))
                removed.append(f)
            except OSError:
                pass
        else:
            git(gd, d, "checkout", job["base"], "--", f, index=idx)
            restored += 1
    for f in removed:
        prune_empty_dirs(d, f)

    job["status"] = "rejected"
    save(job)
    cleanup_shadow(job)
    print(f"rejected {a.job}: restored {restored}, removed {len(removed)} new files")
    if skipped:
        names = ", ".join(skipped[:10])
        if len(skipped) > 10:
            names += " …"
        print(f"skipped {len(skipped)} changed after the job (use --force): {names}")


def cmd_list(a):
    if not os.path.isdir(JOBS):
        return
    for jid in sorted(os.listdir(JOBS))[-15:]:
        try:
            j = load(jid)
        except SystemExit:
            continue
        print(f"{jid}  {j['status']:8}  r{j['round']}  {j['dir']}  {j['task'][:60]!r}")


def main():
    install_signal_handlers()
    p = argparse.ArgumentParser(prog="ds", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    r = s.add_parser("run"); r.add_argument("-C"); r.add_argument("-m")
    r.add_argument("-f", action="append"); r.add_argument("--paths", nargs="+")
    r.add_argument("--check"); r.add_argument("--fix-tries", type=int)
    r.add_argument("--timeout", type=int)
    r.add_argument("task", nargs="?")
    r.set_defaults(fn=cmd_run)
    r = s.add_parser("init"); r.add_argument("-C")
    r.add_argument("--refresh", action="store_true")
    r.add_argument("--timeout", type=int); r.set_defaults(fn=cmd_init)
    r = s.add_parser("revise"); r.add_argument("job"); r.add_argument("feedback")
    r.add_argument("--check"); r.add_argument("--timeout", type=int)
    r.set_defaults(fn=cmd_revise)
    r = s.add_parser("diff"); r.add_argument("job"); r.add_argument("--full", action="store_true")
    r.add_argument("paths", nargs="*"); r.set_defaults(fn=cmd_diff)
    r = s.add_parser("approve"); r.add_argument("job"); r.set_defaults(fn=cmd_approve)
    r = s.add_parser("reject"); r.add_argument("job")
    r.add_argument("--force", action="store_true"); r.set_defaults(fn=cmd_reject)
    s.add_parser("list").set_defaults(fn=cmd_list)
    r = s.add_parser("stats"); r.add_argument("--days", type=int)
    r.add_argument("--all", action="store_true"); r.set_defaults(fn=cmd_stats)
    r = s.add_parser("log"); r.add_argument("job")
    r.add_argument("--tools-only", action="store_true"); r.set_defaults(fn=cmd_log)
    a = p.parse_args()
    if a.cmd == "run" and a.task is None:
        # --paths uses nargs="+"; when it comes before the task, argparse
        # greedily takes the task too. The task is the last value it took.
        if a.paths and len(a.paths) > 1:
            a.task = a.paths.pop()
        else:
            die("missing task (pass a string or - for stdin)")
    a.fn(a)


if __name__ == "__main__":
    main()
